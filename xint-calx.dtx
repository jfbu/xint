%\begin{lverb}
% Hyperbolic functions and their inverses (and the \calxRaw... variants,
% expression functions sinh, cosh, ...), composed from exp, expm1, log1p,
% the internal log and calxfp arithmetic at Q = P + 4 digits, with one final
% rounding; formulas chosen to avoid cancellation. x is rounded to P digits,
% a = |x|, E its decimal exponent, u = expm1(x), w = expm1(-x):
%(
%:  sinh  E < 0: (u - w)/2;  E <= 2: (e^x - e^-x)/2;  else sign e^(a-ln2)
%:  cosh  (e^x + e^-x)/2;  E > 2: e^(a-ln2)
%:  tanh  (u - w)/(u + w + 2);  E > 2: sign 1;  coth the inverse ratio
%:  sech  2/(e^x + e^-x);  csch 2/(u - w) or 2/(e^x - e^-x);  E > 2: e^(ln2-a)
%:  asinh sign log1p(a + a^2/(1 + sqrt(1 + a^2)));  E >= Q: log1p(2a)
%:  acosh log1p(t + sqrt(t(t+2))), t = x - 1;  E >= Q: log1p(2x)
%:  atanh sign log1p(q/(1 + sqrt(1 + q))), q = 2a/(1 - a)
%:  acoth the same with q = 2/(a - 1)
%:  asech acosh(1/x) with t = (1 - x)/x;  E < -Q/2: log1p((2 - x)/x)
%:  acsch asinh(1/a) with sign;  E >= Q/2: 1/x;  E < -Q/2: log1p((2-a)/a)
%)
% asinh, atanh: E < -Q/2 gives x. log1p is applied to its Q-digit
% argument without rounding it to P digits (its three paths accept it).
% Entry \CALX_hyd<code><tag><sign> -> \csname CALX_hy<code><tag><sign>
% with Q. in front (Q = P + 4, P < 8 counts as 8); codes S C T K E H
% (sinh .. csch), s c t k e h (asinh ..
% acsch); the F macros of both signs come from the template \CALX_hyT.
%\end{lverb}
%    \begin{macrocode}
\edef\CALX_hytwo{\romannumeral0\CALX_ffromraw{2[0]}}%
\edef\CALX_hyup{\romannumeral0\CALX_ffromraw{1[0]}}%
\edef\CALX_hyum{\romannumeral0\CALX_ffromraw{-1[0]}}%
\edef\CALX_hyzero{\romannumeral0\CALX_ffromraw{0[0]}}%
\expandafter\let\csname CALX_hyu+\endcsname\CALX_hyup
\expandafter\let\csname CALX_hyu-\endcsname\CALX_hyum
\def\CALX_hyd #1#2#3%
   {\expandafter\CALX_hye\the\numexpr\ifnum\XINTdigits<\xint_c_viii
    \xint_c_viii\else\XINTdigits\fi+\xint_c_iv.#1#2#3}%
\def\CALX_hye #1.#2#3#4%
   {\csname CALX_hy#2\ifnum\XINTdigits<9 w\fi#3#4\endcsname#1.#3#4}%
%    \end{macrocode}
