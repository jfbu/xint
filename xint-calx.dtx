    {\expandafter\XINT_expr_put_op_first
     \expanded{{{\xintToggle{#1}[0]}}\expandafter
     }\romannumeral`&&@\XINT_expr_getop}%
\def\XINT_expr_onliteral_protect #1)%
    {\expandafter\XINT_expr_put_op_first
     \expanded{{{\detokenize{#1}}}\expandafter
     }\romannumeral`&&@\XINT_expr_getop}%
\def\XINT_expr_onliteral_qint #1)%
    {\expandafter\XINT_expr_put_op_first
     \expanded{{{\xintiNum{#1}[0]}}\expandafter
     }\romannumeral`&&@\XINT_expr_getop}%
\xintFor* #1 in {{bool}{togl}{protect}{qint}}\do{%
    \expandafter\let\csname XINT_flexpr_onliteral_#1\expandafter\endcsname
                    \csname XINT_expr_onliteral_#1\endcsname
    \expandafter\let\csname XINT_iiexpr_onliteral_#1\expandafter\endcsname
                    \csname XINT_expr_onliteral_#1\endcsname
}%
