% division of |A| 10^(N+1) by B (\CALX_ndivision, shifts \CALX_nshl, k <=
% 0 identity): Q = floor(10|X|) and R; T = floor(Q/10) (\CALX_nshr), d =
% Q mod 10 (last digit of the lowest block), z = 1 if R > 0 or d > 0.
