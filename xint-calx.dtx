   {\expandafter\XINT_trunc_a\romannumeral0\XINT_infrac{#3}#1.\XINT_trunc_b#2}%
\def\XINT_trunc_a #1#2#3#4.#5%
   {\expandafter\XINT_trunc_c\the\numexpr#1+#4.{#2}{#3}#5#4.}%
\def\XINT_trunc_c #1.#2#3#4%
   {\expandafter#4\romannumeral0\CALX_fintp{#2}{#3}{#1}}%
\def\XINT_trunc_b #1#2#3.#4#5#6.#7%
{%
    \if0#2\if0#5\XINT_trunc_z\fi\fi
    \if-#1\xint_dothis{#7#2#3.-#6.}\fi
    \xint_orthat{#7#2#3.\space#6.}%
