% \subsection{Interface for \xintexprnameimp usage}
%\begin{lverb}
% Attention: N and I are STILL of catcode 12.  We now also make M of catcode
% 12. Be extra careful with macro names.
%
% The integer type of \xintiieval: M<s><n>.<e>.<blocks>, the value of
% the N value N<s><n>.<blocks> (n blocks 1dddddddd!, least significant
% first) times 10^(8e), e >= 0, lowest block non-zero; zero is M+0.0.
% \CALX_ntom: N value (blocks in the stream) to M, the low zero blocks
% go into e. \CALX_mfromraw: raw integer (xintcore format) to M.
% \CALX_mtoraw: M to raw integer, 8e zeros written out.
% \CALX_ntomd d.N...: as \CALX_ntom, e starting at d; \CALX_ntoms: same,
% special values (I...) passed as they are.
%
% Syntax of the entry points (A, B, X f-expanded; M, I values, or raw
% integers converted on entry; R a raw integer):
%(
%  \CALX_ntom N<s><n>.<blocks>       -> <space>M<s><n'>.<e>.<blocks'>
%:  \CALX_ntomd d.N<s><n>.<blocks>    -> the same, e counted from d
%:  \CALX_mfromraw{R}                 -> <space>M...
%:  \CALX_mtoraw{X}                   -> <raw integer>    (X an M value)
%:  \CALX_tom{X}                     -> <space>M...\xint: or <space>I<s>\xint:
%:  \CALX_mr{X}                       -> <raw integer> (X M, A, A[N] N >= 0),
%:                                        X otherwise (I, A[N] N < 0)
%:  \CALX_mrl <item>...<item>^        -> {\CALX_mr{<item>}}...  (in \expanded)
%:  \CALX_ii<op>{A}{B}, \CALX_ii<op>{X}  -> <space>M... or <space>I<s>
%:  \calxii<Name>{A}{B}, \calxii<Name>{X} -> M... or I<s>   (f-expandable)
%:  \CALX_iilit{A}{N}                 -> <space>M..., or <space>A[N]
%)
% \CALX_ntom, \CALX_ntomd, \CALX_mfromraw, \CALX_mtoraw, \CALX_tom and the
% \CALX_ii<op> are used with \romannumeral0. The comparisons \calxiiLt,
% \calxiiGt, \calxiiLtorEq, \calxiiGtorEq, \calxiiEq, \calxiiNotEq give
% raw 1 or 0; \calxiiDivMod gives {Q}{R}; \calxiiPow{A}{k}.
%
% M layer (used as \romannumeral0\CALX_ii<op>{A}{B}, results M or I):
% \CALX_tom{X}: X f-expanded; M left as it is (the tag re-emitted with
% the catcode of this block: a value compiled in a user function may
% carry another one), raw integer converted; A[N] with N >= 0: A
% followed by N zeros (\CALX_tom_w); A[N] with N < 0 and A/B[N]:
% \CALX_tom_x, integer check (error, then truncation) by one
% native division (\CALX_iiq: A 10^max(N,0) by B 10^max(-N,0), B > 0;
% an integer iff the remainder is zero; truncation = floor quotient, plus
% one if negative); I+, I-, I? left as they are; \xint: follows.
% \CALX_iitwo<cont><spcont>{A}{B} hands M(A)\xint:M(B)\xint: to <cont>,
% or the same with an I value to <spcont> (tag test \CALX_iitwo_b).
% Special values propagate as in the N kernels (rules of calxcore):
% \CALX_iisp_g<fin><kernel> calls the N kernel on the operands, M ones
% converted with their e zero blocks written out (\CALX_mton), result
% through \CALX_ntoms (I kept). Unary ops: \CALX_iiun<Mcont><Icont>;
% opp, abs, sqr act on the I sign, isqrt calls \CALX_nsqrtrem, ^ with an
% I base: k = 0 gives 1, I? stays, k < 0 gives 0, else I+ or I- (odd k,
% I- base). Comparisons with an I? operand: InvalidOperation, 0 (== is
% false, != true, no signal); infinities ordered by \CALX_icl<tag><sign>.
% mul, sqr: e1+e2 (2e), N kernel
% \CALX_nmul. add, sub and the division family (divtrunc, modtrunc,
% divfloor, mod, quo, rem, divround, division, divmod, kernels
% \CALX_n... of calxcore): with d = min(e1,e2) the operand of larger e
% gets e - d zero blocks; the quotient has e = 0, a sum or remainder
% e = d. opp, abs: sign token. isqrt: all e zero blocks written out
% (\CALX_nsqrtrem), result e = 0.
%
% \xintiieval. Literals (receivers of the scanner's fake operators):
% digits to M (\CALX_mfromraw); with [N] (decimal mark, exponent, raw
% [N]): \CALX_iilit, M if the value is an
% integer, else the raw A[N] (for num(), round(), trunc()); in compiled
% functions (\XINT_expr_redefinemacros) literals stay raw. Operators
% and functions: \calxii<Name>, one token each (needed by the
% \xintdeffunc hooks). Native: Add, Sub, Mul, Sqr, Opp, Abs, Sqrt,
