% \subsection{Series kernels with three-limb passes (P above 40)}
%\begin{lverb}
% Generic path (P >= 9, |X| < 0.8): fixed point Horner on 4-digit limbs
% with the precision schedule of xinttrig (decreasing widths).
% u = X^2, S(u) = sum (-u)^k/(2k+1)!, C(u) = sum (-u)^k/(2k)!, c_k the
% coefficients. Scale 10^(4A) (A limbs) at all levels. Level k = N-1..0:
%(
%:   T_k = C_k - ceil(U_k T_{k+1} / 10^(4 b_k)),   T_N = C_N,
%)
% C_k = floor(c_k 10^(4A)), U_k = floor(u 10^(4 b_k)) (b_k limbs, the
% top b_k limbs of U_0). T_k is kept on its n_k significant limbs
% (c_k 10^(4A) + 4 < 10^(4 n_k): the other limbs are zero), n_0 = A.
%
% Error on S (or C), units 10^(-4A), u <= 0.64: level k contributes
% u^k (1 (C_k) + 1 (ceil) + 10^(4A-4 b_k) T_{k+1} 10^(-4A)), T_N 1,
% tail u^(N+1)/(2N+3)! (resp. (2N+2)!). The table below (generated by
% tools/trig_sched2.py with exact rationals, all P = 9..100) chooses N,
% A, b_k, n_k so that the total is <= 0.005 10^-P S_min (S_min =
% sin(0.8)/0.8, C_min = cos(0.8)): relative error <= 0.005 ulp before
% the single final rounding (sin X = round_P(X S), cos X = round_P(C)).
%
% The c_k are computed at load time by the recurrence c_k = c_{k-1} /
% ((2k)(2k+1)) (resp. ((2k-1)(2k))) on floor(10^140 c_k) (no factorial;
% error < 2 10^-140, i.e. < 10^-30 unit), then truncated to 10^(4A).
%
% Product: the
% level list has L = b_k + n_k items <u>,<a>! (LS first), item i stands
% for column i: items i < b_k are u_i,0!, items b_k + j are 0,c_j! (the
% limbs of C_k), then the sentinel \CALX_qW,0!. One pass handles three
% limbs t0, t1, t2 of T_{k+1} (missing ones are 0): with a window of the
% three previous u's, column i becomes x = a + carry - t0 u_i - t1 u_(i-1)
% - t2 u_(i-2); the pass emits u_(i-3),low(x)! (the u's move three items
% up, the columns stay: the next pass multiplies by t3, t4, t5). After
% ceil(m/3) passes the items hold the limbs of D = C_k 10^(4 b_k) - U_k
% T_{k+1} modulo 10^(4L) (carries out of item L-1 and the u's leaving
% the list only concern columns >= L), exact since 0 <= D < 10^(4L)
% (D 10^(-4 b_k) = T_k, n_k limbs; for k = 0, C_0 = 10^(4A) is 0 modulo
% 10^(4L)). T_k = items b_k..L-1. |x| < 3.0003 10^8: 1400000000 + x has
% 10 digits, the first six minus 140000 are the carry, the last four
% the low limb (carry by offset).
%\end{lverb}
%    \begin{macrocode}
%    \end{macrocode}
