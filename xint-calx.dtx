    \errhelp{See the comments of calxcore.sty on \string\calxsetup.}%
    \errmessage{calxcore: invalid input to \string\calxsetup}%
}%
\def\CALX_tmpa #1{%
    \expandafter\def\csname CALX_setup_#1.trap\endcsname{\CALX_settrap{#1}}%
