% \subsubsection{\csh{CALX_nsqrt_two}}
%\begin{lverb}
% \CALX_nsqrt_two <cont>{h}{l}: h, l eight digit strings (l with leading
% zeros), X = h 10^8 + l, h >= 10^7. Expands to <cont>{s}{r} with
% s = isqrt(X), r = X - s^2 (explicit integers, r <= 2s). Uses (5):
% s = N - 1, r = 2N - 1 - D.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_two #1#2#3%
   {\expandafter\CALX_nsqrt_two_a\romannumeral0\CALX_sqrt_start 16.#2#3.#1}%
\def\CALX_nsqrt_two_a #1#2#3%
   {\expandafter#3\expandafter{\the\numexpr#1-\xint_c_i\expandafter}%
    \expandafter{\the\numexpr\xint_c_ii*#1-\xint_c_i-#2}}%
%    \end{macrocode}
% \subsubsection{\csh{CALX_nsqrt_iv}}
%\begin{lverb}
% \CALX_nsqrt_iv <cont>{a3}{a2}{a1}{a0}: eight digit strings (leading zeros
% allowed except a3 >= 25000000), X = a3 B^3 + a2 B^2 + a1 B + a0, B=10^8.
% Expands to <cont>{S}{T}{H}{L}: isqrt(X) = S B + T with S explicit and T
% as a native block 1dddddddd, remainder X - isqrt(X)^2 = H B + L, H, L
% explicit, 0 <= L < B, H <= 2 10^8.
%
% One Zimmermann step on the two block square root (s',r') of a3 B + a2:
% q = floor((r' B + a1)/(2s')), estimate q0 = round(r' B/(2s')) (eTeX
% scaled product), exact u = r' B + a1 - 2s' q0 in 10^4 halves (every
% intermediate < 2^31), one +-1 correction; then r = u B + a0 - q^2 and
% the final correction r < 0: r += 2s - 1, s -= 1. q = B occurs only with
% r' = 2s' and then always gets corrected.
%
% Floor of x/10^4 for x >= 0 is (x+5000)/10000-1 in \numexpr.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_iv #1#2#3#4#5{\CALX_nsqrt_two%
    \CALX_nsqrt_iv_a{#2}{#3}{#4}{#5}#1}%
\def\CALX_nsqrt_iv_a #1#2%
{%
    \expandafter\CALX_nsqrt_iv_b
    \the\numexpr#2*\xint_c_e_viii/(\xint_c_ii*#1).{#1}{#2}%
}%
\def\CALX_nsqrt_iv_b #1.#2%
{%
    \expandafter\CALX_nsqrt_iv_c
    \the\numexpr(#1+5000)/\xint_c_e_iv-\xint_c_i\expandafter.%
    \the\numexpr(\xint_c_ii*#2+5000)/\xint_c_e_iv-\xint_c_i.#1.{#2}%
}%
%    \end{macrocode}
%\begin{lverb}
% #1=qh, #2=th, #3=q0, #4=s', #5=r', #6=a1. With t=2s', ql=q0-qh 10^4,
% tl=t-th 10^4: u = ((r'-th qh) 10^4 - (th ql + tl qh)) 10^4 - tl ql + a1.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_iv_c #1.#2.#3.#4#5#6%
{%
    \expandafter\CALX_nsqrt_iv_d
    \the\numexpr((#5-#2*#1)*\xint_c_e_iv
       -(#2*(#3-#1*\xint_c_e_iv)+(\xint_c_ii*#4-#2*\xint_c_e_iv)*#1))*%
           \xint_c_e_iv
       -(\xint_c_ii*#4-#2*\xint_c_e_iv)*(#3-#1*\xint_c_e_iv)+#6.#3.{#4}%
}%
\def\CALX_nsqrt_iv_d #1.#2.#3%
{%
    \expandafter\CALX_nsqrt_iv_e\the\numexpr#1%
      \ifnum#1<\xint_c_ +\xint_c_ii*#3\else
      \ifnum#1<\numexpr\xint_c_ii*#3\relax\else-\xint_c_ii*#3\fi\fi
    \expandafter.\the\numexpr#2%
      \ifnum#1<\xint_c_ -\xint_c_i\else
      \ifnum#1<\numexpr\xint_c_ii*#3\relax\else+\xint_c_i\fi\fi
    .{#3}%
}%
%    \end{macrocode}
%\begin{lverb}
% #1=u, #2=q (0 <= q <= B), #3=s', #4=a0. With qh, ql the 10^4 halves of
% q and c = 2 qh ql = ch 10^4 + cl: r = (u - qh^2 - ch) B
% + (a0 - ql^2 - cl 10^4); the low part is > -2 10^8.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_iv_e #1.#2.%
{%
    \expandafter\CALX_nsqrt_iv_f
    \the\numexpr(#2+5000)/\xint_c_e_iv-\xint_c_i.#2.#1.%
}%
\def\CALX_nsqrt_iv_f #1.#2.%
{%
    \expandafter\CALX_nsqrt_iv_g
    \the\numexpr\xint_c_ii*#1*(#2-#1*\xint_c_e_iv).#1.#2.%
}%
\def\CALX_nsqrt_iv_g #1.%
{%
    \expandafter\CALX_nsqrt_iv_h\the\numexpr(#1+5000)/\xint_c_e_iv-%
        \xint_c_i.#1.%
}%
\def\CALX_nsqrt_iv_h #1.#2.#3.#4.#5.#6#7%
{%
    \expandafter\CALX_nsqrt_iv_i
    \the\numexpr#7-(#4-#3*\xint_c_e_iv)*(#4-#3*\xint_c_e_iv)
                -(#2-#1*\xint_c_e_iv)*\xint_c_e_iv\expandafter.%
    \the\numexpr#5-#3*#3-#1.#4.{#6}%
}%
%    \end{macrocode}
%\begin{lverb}
% #1=low part x in (-2 10^8, 10^8), #2=high part, #3=q, #4=s'.
% Borrow k = floor(x/B) = (x+250000000)/100000000-3.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_iv_i #1.%
{%
    \expandafter\CALX_nsqrt_iv_j\the\numexpr(#1+250000000)/\xint_c_e_viii-%
        \xint_c_iii.#1.%
}%
\def\CALX_nsqrt_iv_j #1.#2.#3.%
{%
    \expandafter\CALX_nsqrt_iv_k
    \the\numexpr#3+#1\expandafter.\the\numexpr#2-#1*\xint_c_e_viii.%
}%
%    \end{macrocode}
%\begin{lverb}
% #1=H, #2=L, #3=q, #4=s', #5=cont. If H < 0: H += 2s', L += 2q - 1
% (L in [-1, 3 10^8)), carry (L+150000000)/100000000-2, q -= 1 with a
% borrow from s' if q was 0.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_iv_k #1.#2.#3.#4#5%
{%
    \ifnum#1<\xint_c_
      \xint_dothis{\expandafter\CALX_nsqrt_iv_l
         \the\numexpr#2+\xint_c_ii*#3-\xint_c_i\expandafter.%
         \the\numexpr#1+\xint_c_ii*#4\expandafter.%
         \the\numexpr#3-\xint_c_i.{#4}#5}\fi
    \xint_orthat{\expandafter#5\expandafter{\the\numexpr#4\expandafter}%
         \expandafter{\the\numexpr#3+\xint_c_e_viii}{#1}{#2}}%
}%
\def\CALX_nsqrt_iv_l #1.%
{%
    \expandafter\CALX_nsqrt_iv_m\the\numexpr(#1+150000000)/\xint_c_e_viii-%
        \xint_c_ii.#1.%
}%
\def\CALX_nsqrt_iv_m #1.#2.#3.#4.%
{%
    \expandafter\CALX_nsqrt_iv_n
    \the\numexpr#3+#1\expandafter.\the\numexpr#2-#1*\xint_c_e_viii.#4.%
}%
\def\CALX_nsqrt_iv_n #1.#2.#3.#4#5%
{%
    \expandafter#5\expandafter
    {\the\numexpr#4\ifnum#3<\xint_c_ -\xint_c_i\fi\expandafter}\expandafter
    {\the\numexpr\ifnum#3<\xint_c_ 199999999\else#3+\xint_c_e_viii\fi}%
    {#1}{#2}%
}%
%    \end{macrocode}
% \subsubsection{\csh{CALX_nsqrt_vi}}
%\begin{lverb}
% \CALX_nsqrt_vi <cont>{a5}{a4}{a3}{a2}{a1}{a0}: eight digit strings,
% a5 >= 25000000. Expands to <cont>{S1}{T}{Q}{R2}{R1}{R0}: isqrt(X) =
% S1 B^2 + T B + Q (T, Q native blocks 1dddddddd), remainder
% R2 B^2 + R1 B + R0 (explicit, 0 <= R1, R0 < B).
%
% One Zimmermann step with b = B on the four block root s' = S1 B + T
% (remainder r' = H B + L) of the top four blocks: t = 2s' = tH B + tL,
% 10^8 <= tH < 2 10^8; q = floor((r' B + a1)/t) is estimated by
% q0 = round(H B/tH) (scaled), q - q0 in [-2, 1]; u = r' B + a1 - q0 t
% is computed exactly as uH B + uL from 10^4 halves (qh, ql, tHh, tHl,
% tLh, tLl): with m0 = a1 - ql tLl, m1 = -(qh tLl + ql tLh),
% Z = ((H - qh tHh) 10^4 - (qh tHl + ql tHh)) 10^4 + L - (qh tLh + ql tHl),
% c0 = floor(m0/10^4), c1 = floor((m1+c0)/10^4): uH = Z + c1,
% uL = (m1 + c0 - c1 10^4) 10^4 + m0 - c0 10^4. Every intermediate is
% < 2^31 (Z: |u| < 3 t). floor(v/10^4) = (v+500005000)/10000-50001 for
% |v| < 5 10^8. Then the correction loop, r = u B + a0 - q^2 and the final
% correction as in \CALX_nsqrt_iv.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_vi #1#2#3#4#5#6#7%
   {\CALX_nsqrt_iv\CALX_nsqrt_vi_a{#2}{#3}{#4}{#5}{#6}{#7}#1}%
\def\CALX_nsqrt_vi_a #1#2%
   {\expandafter\CALX_nsqrt_vi_b\the\numexpr%
       \xint_c_ii*#2-200000000.{#1}{#2}}%
\def\CALX_nsqrt_vi_b #1.#2#3#4#5%
{%
    \expandafter\CALX_nsqrt_vi_c
    \the\numexpr\xint_c_ii*#2\ifnum#1<\xint_c_e_viii\else+\xint_c_i\fi
    \expandafter.\the\numexpr#1\ifnum#1<\xint_c_e_viii\else-\xint_c_e_viii\fi
    .{#4}{#5}{{#2}{#3}}%
