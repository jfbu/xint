% \subsection{Integer square root: small and medium sizes}
% \subsubsection{\csh{CALX_sqrt_start}}
%\begin{lverb}
% xint's square root start and its small and medium paths (inputs of at
% most 16 digits), renamed. It is only called with at most 16 digits
% (calx, and xint's \xintiiSquareRoot since s58).
%
% Output: {N}{D} with D = N^2 - X > 0, N smallest (N = isqrt(X) + 1).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_sqrt_start #1.%
{%
    \ifnum #1<\xint_c_x\xint_dothis\CALX_sqrt_small_a\fi
    \xint_orthat\CALX_sqrt_big_a #1.%
}%
\def\CALX_sqrt_small_a #1.{\CALX_sqrt_a #1.\CALX_sqrt_small_d }%
\def\CALX_sqrt_big_a   #1.{\CALX_sqrt_a #1.\CALX_sqrt_big_d   }%
\def\CALX_sqrt_a #1.%
{%
   \ifodd #1
     \expandafter\CALX_sqrt_bO
   \else
     \expandafter\CALX_sqrt_bE
   \fi
   #1.%
}%
\def\CALX_sqrt_bE #1.#2#3#4%
{%
    \CALX_sqrt_c {#3#4}#2{#1}#3#4%
}%
\def\CALX_sqrt_bO #1.#2#3%
{%
    \CALX_sqrt_c #3#2{#1}#3%
}%
\def\CALX_sqrt_c #1#2%
{%
    \expandafter #2%
    \the\numexpr \ifnum #1>\xint_c_ii
                 \ifnum #1>\xint_c_vi
                 \ifnum #1>12 \ifnum #1>20 \ifnum #1>30
                 \ifnum #1>42 \ifnum #1>56 \ifnum #1>72
                 \ifnum #1>90
      10\else 9\fi \else 8\fi \else 7\fi \else 6\fi \else 5\fi
        \else 4\fi \else 3\fi \else 2\fi \else 1\fi .%
}%
\def\CALX_sqrt_small_d #1.#2%
{%
   \expandafter\CALX_sqrt_small_e
   \the\numexpr #1\ifcase \numexpr #2/\xint_c_ii-\xint_c_i\relax
                   \or 0\or 00\or 000\or 0000\fi .%
}%
\def\CALX_sqrt_small_e #1.#2.%
{%
   \expandafter\CALX_sqrt_small_ea\the\numexpr #1*#1-#2.#1.%
}%
\def\CALX_sqrt_small_ea #1%
{%
    \if0#1\xint_dothis\CALX_sqrt_small_ez\fi
    \if-#1\xint_dothis\CALX_sqrt_small_eb\fi
    \xint_orthat\CALX_sqrt_small_f #1%
}%
\def\CALX_sqrt_small_ez 0.#1.{\expandafter{\the\numexpr#1+\xint_c_i
         \expandafter}\expandafter{\the\numexpr #1*\xint_c_ii+\xint_c_i}}%
\def\CALX_sqrt_small_eb -#1.#2.%
{%
    \expandafter\CALX_sqrt_small_ec \the\numexpr
    (#1-\xint_c_i+#2)/(\xint_c_ii*#2).#1.#2.%
}%
\def\CALX_sqrt_small_ec #1.#2.#3.%
{%
    \expandafter\CALX_sqrt_small_f \the\numexpr
      -#2+\xint_c_ii*#3*#1+#1*#1\expandafter.\the\numexpr #3+#1.%
}%
\def\CALX_sqrt_small_f #1.#2.%
{%
   \expandafter\CALX_sqrt_small_g
   \the\numexpr (#1+#2)/(\xint_c_ii*#2)-\xint_c_i.#1.#2.%
}%
\def\CALX_sqrt_small_g #1#2.%
{%
    \if 0#1%
       \expandafter\CALX_sqrt_small_end
    \else
       \expandafter\CALX_sqrt_small_h
    \fi
    #1#2.%
}%
\def\CALX_sqrt_small_h #1.#2.#3.%
{%
    \expandafter\CALX_sqrt_small_f
    \the\numexpr #2-\xint_c_ii*#1*#3+#1*#1\expandafter.%
    \the\numexpr #3-#1.%
}%
\def\CALX_sqrt_small_end #1.#2.#3.{{#3}{#2}}%
\def\CALX_sqrt_big_d #1.#2%
{%
   \ifodd #2 \xint_dothis{\expandafter\CALX_sqrt_big_eO}\fi
   \xint_orthat{\expandafter\CALX_sqrt_big_eE}%
   \the\numexpr (#2-\xint_c_i)/\xint_c_ii.#1;%
}%
\def\CALX_sqrt_big_eE  #1;#2#3#4#5#6#7#8#9%
{%
    \CALX_sqrt_big_eE_a #1;{#2#3#4#5#6#7#8#9}%
}%
\def\CALX_sqrt_big_eE_a #1.#2;#3%
{%
    \expandafter\CALX_sqrt_bigormed_f
    \romannumeral0\CALX_sqrt_small_e #2000.#3.#1;%
}%
\def\CALX_sqrt_big_eO #1;#2#3#4#5#6#7#8#9%
{%
    \CALX_sqrt_big_eO_a #1;{#2#3#4#5#6#7#8#9}%
}%
\def\CALX_sqrt_big_eO_a #1.#2;#3#4%
{%
    \expandafter\CALX_sqrt_bigormed_f
    \romannumeral0\CALX_sqrt_small_e #20000.#3#4.#1;%
}%
%    \end{macrocode}
%\begin{lverb}
% calx (s58): \CALX_sqrt_start is only ever called with at most 16 digits
% (calxint, xint's \xintiiSquareRoot), hence here k = #3 <= 8: the
% medium path only. xint's big branch (\XINT_sqrt_big_f, more than 16
% digits) is deleted: xint and xintfrac use the native square roots.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_sqrt_bigormed_f #1#2#3;%
   {\csname CALX_sqrt_med_f#3\endcsname #1.#2.#3;}%
\expandafter\def\csname CALX_sqrt_med_f5\endcsname   {\CALX_sqrt_med_fa .}%
\expandafter\def\csname CALX_sqrt_med_f6\endcsname  {\CALX_sqrt_med_fa 0.}%
\expandafter\def\csname CALX_sqrt_med_f7\endcsname {\CALX_sqrt_med_fa 00.}%
\expandafter\def\csname CALX_sqrt_med_f8\endcsname{\CALX_sqrt_med_fa 000.}%
\def\CALX_sqrt_med_fa #1.#2.#3.#4;%
{%
    \expandafter\CALX_sqrt_med_fb
    \the\numexpr (#30#1-5#1)/(\xint_c_ii*#2).#1.#2.#3.%
}%
\def\CALX_sqrt_med_fb #1.#2.#3.#4.#5.%
{%
    \expandafter\CALX_sqrt_small_ea
    \the\numexpr (#40#2-\xint_c_ii*#3*#1)*10#2+(#1*#1-#5)\expandafter.%
    \the\numexpr #30#2-#1.%
}%
%    \end{macrocode}
