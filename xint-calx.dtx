% \subsection{Sign and zero tests of values}
% \subsubsection{\csh{CALX_ifnz}, \csh{CALX_ifsgn}}
%\begin{lverb}
% Syntax (use with \romannumeral0; X f-expanded):
%(
%  \CALX_ifnz{X}{A}{B}                 -> <space>A (X <> 0) or <space>B
%:  \CALX_ifnz_a <v>\xint:<y><n>        -> <y> (v <> 0) or <n>
%:  \CALX_ifsgn{X}{A}{B}{C}             -> <space>A, B or C (X <0, =0, >0)
%:  \CALX_ifsgn_a <v>\xint:{A}{B}{C}    -> the same
%)
% The values are those of the three parsers, after f-expansion: native
% N<s><n>., M<s><n>.<e>., F<s><D>.<e>. (blocks after the header), I+,
% I-, I?, or raw A, A[N], A/B[N] (A a raw integer without leading zeros,
% B > 0). The low level forms take the value v already expanded, in front
% of the \xint: that ends it; \CALX_ifnz_a also takes the two tokens <y>
% and <n> which select a branch (\CALX_ifnz uses \xint_stop_atfirstoftwo,
% \xint_stop_atsecondoftwo; loops use \xint_firstoftwo, \xint_secondoftwo,
% which add no space).
%
% Only the first tokens are read, no xintfrac parsing: 0 is zero, - is
% negative, another digit is positive; a token of character code above `9
% is a tag: I+ and I- are infinities, I? is non-zero for \CALX_ifnz and
% signals InvalidOperation for \CALX_ifsgn, which then takes the zero
% branch; after F, M, N comes the sign token, then the count, whose first
% character is 0 only for zero.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_ifnz #1{\expandafter\CALX_ifnz_a\romannumeral`&&@#1\xint:%
    \xint_stop_atfirstoftwo\xint_stop_atsecondoftwo}%
\def\CALX_ifnz_a #1%
{%
    \if0#1\xint_dothis\CALX_ifnz_z\fi
    \ifnum`#1>57 \xint_dothis\CALX_ifnz_t\fi
    \xint_orthat\CALX_ifnz_n #1%
}%
\def\CALX_ifnz_t #1#2%
   {\if I#1\expandafter\CALX_ifnz_n\else\expandafter\CALX_ifnz_c\fi}%
\def\CALX_ifnz_c #1%
   {\if0#1\expandafter\CALX_ifnz_z\else\expandafter\CALX_ifnz_n\fi}%
\def\CALX_ifnz_z #1\xint:#2#3{#3}%
\def\CALX_ifnz_n #1\xint:#2#3{#2}%
\def\CALX_ifsgn #1{\expandafter\CALX_ifsgn_a\romannumeral`&&@#1\xint:}%
\def\CALX_ifsgn_a #1%
{%
    \if0#1\xint_dothis\CALX_ifsgn_z\fi
    \if-#1\xint_dothis\CALX_ifsgn_m\fi
    \ifnum`#1>57 \xint_dothis\CALX_ifsgn_t\fi
    \xint_orthat\CALX_ifsgn_p #1%
}%
\def\CALX_ifsgn_t #1#2%
   {\if I#1\expandafter\CALX_ifsgn_i\else\expandafter\CALX_ifsgn_c\fi #2}%
\def\CALX_ifsgn_c #1#2%
{%
    \if0#2\xint_dothis\CALX_ifsgn_z\fi
    \if-#1\xint_dothis\CALX_ifsgn_m\fi
    \xint_orthat\CALX_ifsgn_p
}%
\def\CALX_ifsgn_i #1%
{%
    \if-#1\xint_dothis\CALX_ifsgn_m\fi
    \if+#1\xint_dothis\CALX_ifsgn_p\fi
    \xint_orthat\CALX_ifsgn_q
}%
\def\CALX_ifsgn_q #1\xint:%
   {\expandafter\CALX_ifsgn_z\romannumeral`&&@%
    \CALX_signalcondition{InvalidOperation}{sign of I?}{}{}\xint:}%
\def\CALX_ifsgn_z #1\xint:{\xint_stop_atsecondofthree}%
\def\CALX_ifsgn_m #1\xint:{\xint_stop_atfirstofthree}%
\def\CALX_ifsgn_p #1\xint:{\xint_stop_atthirdofthree}%
%    \end{macrocode}
% \subsection{Native addition and subtraction}
% \subsubsection{\csh{CALX_nadd}}
%\begin{lverb}
% Syntax (use with \romannumeral0; X, Y f-expanded, native integers or
% I+, I-, I?):
%(
%  \CALX_nadd{X}{Y}  -> <space>Z    Z = X + Y
%:  \CALX_nsub{X}{Y}  -> <space>Z    Z = X - Y
%)
% Z: native integer, or I+, I-, I? (special operands, rules of the
% signals section).
%
% Addition and subtraction: dispatch.
%
% \CALX_nadd{X}{Y}: \CALX_nadd_x f-expands Y and leaves
%( Y\xint:X1;!1;!1;!1;!\W\xint:
%)
% so that X is already followed by the kernel terminator. With P = Y
% (count n, sign s) and Q = X (count m, sign t), \CALX_nadd_y grabs only
% P's list and Q's header N<t><m>. and runs a chain of tests. A test
% that fires puts a "jumper" in its branch: a macro taking a few data
% tokens, delimited by the \fi of that branch, which swallows the rest
% of \CALX_nadd_y's body (P's list included) and starts with the \fi it
% removed. Without jumper, the common case runs inline: same signs and
% n<=m, kernel started with P's list, Q's list left where it is.
%( n=0: Q                                  \CALX_nadd_retx
%: m=0: P                                  \CALX_nadd_rety
%: s<>t, n<m: |Q|-|P|, sign t, Q in place \CALX_ndiff_q
%: s<>t, n>m: |P|-|Q|, sign s              \CALX_ndiff_p
%: s<>t, n=m: P-Q, possibly negative       \CALX_ndiff_e
%: s=t,  n>m: Q shorter                    \CALX_nsum_q
%: s=t,  n<=m: inline
%)
% The count of the result (m, or n) is written BEFORE the kernel:
%( \expandafter\CALX_naddm\expandafter<sign>\the\numexpr<count>%
%:   \expandafter.\the\numexpr\CALX_nadd_a\xint_c_ii<S>1;!1;!1;!1;!\W
%:   <L>1;!1;!1;!1;!\W\xint:
%)
% Lists grabbed: P's once more in the jumper cases, Q's once in
% \CALX_ndiff_p, _e and \CALX_nsum_q, the result once by the final macro
% (its header must precede it).
%
% Addition kernel: xintcore's \XINT_add_a ... \XINT_add_o (xintcore
% l.598-668, code-only numbering), copied as \CALX_nadd_a ... \CALX_nadd_o.
%
% Contract: first list the SHORTER (or equal) one, both lists followed by
% 1;!1;!1;!1;!\W, initial state 2; output: the LS-first sum blocks followed
% by 1;!, then the tokens which followed the second list's \W. The only
% place where the result gets one more block than the longer operand is
% \XINT_add_lf, which appends block 00000001; its copy \CALX_nadd_lf also
% emits +\xint_c_i after the 1;!, before the final \xint:. \CALX_naddm
% grabs <count>. the list and that optional increment.
%
% Subtraction kernel: xintcore's \XINT_sub_a ... \XINT_sub_i with
% \XINT_sub_bi, _di, _fi, _hi (xintcore l.786-851, code-only numbering),
% copied as \CALX_nsub_*. Contract: called as
%( \CALX_nsub_a\xint_c_i <S>1;!1;!1;!1;!\W <L>1;!1;!1;!1;!\W
%)
% with S not longer than L, it computes L-S; each step produces a block and a
% state digit, 1 for no borrow, 0 for borrow; when S is exhausted it calls
%( \CALX_nsub_k <state><remaining L blocks>1;!1;!1;!1;!\W
%)
% xintcore's \XINT_sub_k and what follows are tied to its decimal output; the
% end of the loop (\CALX_nsub_k and the following) is calx's own. It ends
% the list with 1;! followed by one digit, before the final \xint:.
%
% Unequal lengths (n_L > n_S): remaining L blocks are not empty and
% |L| > |S|, so a final borrow is absorbed by L:
%- no borrow: copy the remaining blocks (\CALX_nsub_kc), digit 0;
%- borrow: 00000000 blocks become 99999999 and the borrow goes on; the
% first non zero block d becomes d-1, then copy (\CALX_nsub_kb). If d is
% the top block (next is 1;!) and d=1, the block is dropped
% (\CALX_nsub_kt) and the digit is 1: the blocks produced by the loop
% below it may be zero (e.g. 10^16-(10^16-1)). This happens only when
% n_L=n_S+1, the top block of L is 00000001 and absorbs a borrow.
%
% \CALX_nsubu: digit 0, the result is final; digit 1, \CALX_nsubrd takes
