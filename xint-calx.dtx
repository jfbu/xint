%\begin{lverb}
% Syntax (use with \romannumeral0; <kernel> \CALX_fr_b or \CALX_rt_t, n
% digits, X f-expanded):
%(
%  \CALX_rt_a <kernel><n>.X\xint:  -> <space>Y\xint:
%)
% Kernel of \calxFpRoundTo, \calxFpTruncTo (end of this file): Y is the
% multiple of 10^-n nearest to X (\CALX_fr_b), or between 0 and X
% (\CALX_rt_t). n may be negative.
% X: F or I value, M value, or raw A, A[N], A/B, A/B[N]. Y: exact F
% value (no rounding to P), ties of \calxFpRoundTo away from zero; I
% values are returned unchanged. No literal tag in the parameter texts:
% the tag of X may have catcode 11.
%
% F X = s N 10^(8e), D digits: t = -n - 8e low digits of N are dropped.
% t <= 0: X. t > D: zero. t = D: zero (trunc), or s 10^-n if N >=
% 5 10^(D-1) (round: \CALX_rt_h reads the first digit of the top
% block). 1 <= t < D: round: \CALX_fr_b with k = t (the dispatch of
% \CALX_fround, which keeps D - t digits); trunc: \CALX_rt_t, t = 8a + c:
% a blocks dropped (\CALX_fr_sk), the next block v -> m floor(v/m), m =
% 10^c, by (2(10^8 + v) + 1 - m)/(2m) m in \numexpr (no tie).
%
% Raw X with B = 1 (or no B), and M X (\CALX_mtoraw_t): the exact F value
% of A 10^N (\CALX_ffr_a), then the F path. B > 1: Q = trunc(X 10^(n+1))
% by \CALX_fnum_t (one native division), then the F path on Q 10^-(n+1):
% truncation at n + 1 decimals changes neither the truncation nor the
% rounding at n decimals.
%
% Every path ends with Y\xint: (the blocks above the kept ones stay in
% the stream until that \xint:).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_rt_a #1#2.#3%
{%
    \if F#3\xint_dothis{\CALX_rt_f#1#2.}\fi
    \if I#3\xint_dothis{ #3}\fi
    \if M#3\xint_dothis{\CALX_rt_m#1#2.}\fi
    \xint_orthat{\CALX_rt_x#1#2.#3}%
}%
%    \end{macrocode}
