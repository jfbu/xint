% \subsection{Native integer format}
%\begin{lverb}
% A calx integer in native format is the sequence of catcode 12 tokens
%( N <sign> <n> . <block_1> <block_2> ... <block_n>
%)
%- N: type tag;
%- <sign>: + or -, always present; zero is N+0. (no blocks);
%- <n>: number of blocks, decimal, terminated by a dot;
%- the blocks are xint's blocks 1dddddddd! (the 1 protects leading zeros
% for \numexpr), least significant block first;
%- the most significant block (the last one) is not 00000000.
%
% The value is <sign> sum_{k=1}^{n} d_k 10^{8(k-1)} with d_k the 8 digits of
% <block_k>. There is no terminator: macros append their own delimiters.
%
% All macros below are used as \romannumeral0\CALX_n...{...}{...} and
% deliver their result after a space token. Arguments are f-expanded first
% (as in xintcore).
%
% Coding rules followed here (second pass, efficiency):
%- block lists are copied as few times as possible: a macro parameter
% holding blocks appears ONCE in each replacement text; branch selection
% (\xint_dothis/\xint_orthat, \ifcase) only selects a macro token, the
% arguments follow once after the selection;
%- the header N<sign><n>. of a result is produced in front of the blocks
% by \expandafter\CALX_sp\expandafter N\expandafter<sign>\the\numexpr<n>.
% so that the blocks, once grabbed to remove the kernel terminator 1;!,
% are not grabbed again (\CALX_sp expands to the space which ends the
% \romannumeral0 expansion);
%- counting the blocks of a product skips them seven at a time.
%
% In this section N and I have catcode 12, so macro names here use neither
% letter in upper case.
%\end{lverb}
%    \begin{macrocode}
\catcode`N=12 \catcode`I=12
%    \end{macrocode}
%\begin{lverb}
% \CALX_sp expands to a space token; it ends the \romannumeral0 expansion of
% the native macros.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_sp{ }%
%    \end{macrocode}
%\begin{lverb}
% \CALX_pten{k} = 10^k, 0 <= k <= 8, k a \numexpr expression: one
% \csname lookup of \CALX_pt<k> (k in decimal), cheaper than an \ifcase
% table. The other value tables and dispatches of calx are built in the
% same way.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_pten #1{\csname CALX_pt\the\numexpr#1\endcsname}%
\expandafter\def\csname CALX_pt0\endcsname{1}%
\expandafter\def\csname CALX_pt1\endcsname{10}%
\expandafter\def\csname CALX_pt2\endcsname{100}%
\expandafter\def\csname CALX_pt3\endcsname{1000}%
\expandafter\def\csname CALX_pt4\endcsname{10000}%
\expandafter\def\csname CALX_pt5\endcsname{100000}%
\expandafter\def\csname CALX_pt6\endcsname{1000000}%
\expandafter\def\csname CALX_pt7\endcsname{10000000}%
\expandafter\def\csname CALX_pt8\endcsname{100000000}%
%    \end{macrocode}
%\begin{lverb}
% Digit counts without \ifnum (each \ifnum scans its two numbers: three
% nested \ifnum on an 8-digit block cost about twice as much). The digits
% are followed by a sentinel list and the ninth token is the answer
% (xintfrac's \XINT_FL_fac_countdigits); \CALX_nd_b removes the leftover
% sentinel up to \xint: and outputs the answer, so the macros are
% f-expandable.
%- \CALX_ndig{v}: number of digits of 0 <= v < 10^8 (1 for 0); v may have
% leading zeros (removed by \numexpr);
%- \CALX_ndigs{v}: same, v explicit digits without leading zeros;
%- \CALX_nlz{v}: number of leading zeros of an 8-digit block v > 0.
%
% \CALX_nd_c <v><s_1>...<s_10>\xint: (v: 1 to 10 explicit digits, no
% leading zero; s_k: one token or a braced group) outputs s_k for
% k = 11 - (number of digits of v), the eleventh token: a value per digit
% count (sentinel list of the caller).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_ndig #1%
   {\expandafter\CALX_nd_a\the\numexpr#1\relax 87654321\xint:}%
\def\CALX_ndigs #1{\CALX_nd_a #187654321\xint:}%
\def\CALX_nlz #1%
   {\expandafter\CALX_nd_a\the\numexpr#1\relax 01234567\xint:}%
\def\CALX_nd_a #1#2#3#4#5#6#7#8#9{\CALX_nd_b #9}%
\def\CALX_nd_b #1#2\xint:{#1}%
\def\CALX_nd_c #1#2#3#4#5#6#7#8#9{\CALX_nd_d}%
\def\CALX_nd_d #1#2#3\xint:{#2}%
%    \end{macrocode}
