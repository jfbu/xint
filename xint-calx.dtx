                  +\xint_c_e_viii\expandafter.%
      \the\numexpr\ifcase#1 1\or 4\or 16\or 64\fi+\xint_c_e_viii\expandafter.%
      \the\numexpr\ifcase#1 1\or 5\or 25\or 125\fi+\xint_c_e_viii%
          \expandafter.%
      \the\numexpr\ifcase#1 1\or 25\or 625\or 15625\fi+\xint_c_e_viii\expandafter;%
    \fi
      #1.#2.%
}%
\def\CALX_nsqrt_bgg_a #1.#2.#3.#4#5{\CALX_nsqrt_core\CALX_nsqrt_out{#3}{#5}}%
\def\CALX_nsqrt_bgg_b #1;#2.#3.#4.#5#6{\CALX_nsqrt_bgh #2.#3.#1.{N+#5.#6}}%
%    \end{macrocode}
%\begin{lverb}
% \CALX_nsqrt_bgh <j>.<2t>.<D0>.<4^j>.<5^j>.<25^j>.{X}: the four numbers
% after j and 2t are given as 1dddddddd (value + 10^8), D0 = 2^j 10^t.
%
% Y = X 10^(2t) 4^j = X D0^2 (\CALX_nshl, then one one block
% multiplication if j > 0). With (s,r) = core(Y), no division at all
% (1/D0 = 5^j/10^(t+j)):
%(   S = floor(s 5^j / 10^(t+j))             (one block mul + \CALX_nshr),
%:   e = s - S D0                             (one block mul + \CALX_nsub),
%:   R = (r + e(2s - e)) 25^j / 10^(2t+2j)    (exact \CALX_nshr),
%)
% as Y = s^2 + r = X D0^2 and X - S^2 = (r + e(2s-e))/D0^2. The
% multiplications by 5^j, 25^j are skipped when j = 0.
%\end{lverb}
%    \begin{macrocode}
