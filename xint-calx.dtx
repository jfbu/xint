\def\CALX_nsqrt_kwp #1#2#3#4#5#6#7#8;;;;;!%
   {\expandafter\CALX_nsqrt_kwq\expanded{\CALX_nsqrt_kbs{#1}#8;;;;;!}%
       \xint:{#1}{#2}{#3}{#4}{#5}{#6}{#7}}%
\def\CALX_nsqrt_kwq #1;;;;;!#2\xint:%
   {\ifx\relax#2\relax\expandafter\CALX_nsqrt_kwk\else\expandafter%
       \CALX_nsqrt_kfb\fi{#1}}%
\def\CALX_nsqrt_kwk #1#2#3#4#5#6#7#8{%
    \CALX_nsqrt_kwh{#2}{#3}{#4}{#5}{#6}{#7}{#8}#1;;;;;!}%
\def\CALX_nsqrt_kfb #1#2#3#4#5#6#7#8%
   {\expandafter\CALX_nsqrt_kqa\the\numexpr\xint_c_e_viii+#5-\xint_c_i%
