\def\XINT_scipow_b #1#2/#3[#4]#5%
{%
    \unless\if1\XINT_is_One#3XY\xint_dothis\XINT_scipow_c\fi
    \ifnum#4<\xint_c_ \xint_dothis\XINT_scipow_c\fi
    \xint_orthat#5#1#2/#3[#4]%
}%
\def\XINT_scipow_c #1[#2]#3%
{%
    \ifnum\xintSgn{#3}=\xint_c_ \expandafter\XINT_scipow_z
    \else\expandafter\XINT_scipow_e\fi #1[#2]{#3}%
}%
\def\XINT_scipow_e #1[#2]#3{\CALX_ftoraw{\calxFpPow{#3}{#1[#2]}}}%
\def\XINT_scipow_z #1#2[#3]#4%
{%
    \if-#1\xint_dothis{\XINT_legacysignalcondition{InvalidOperation}%
        {0 raised to power #1#2[#3].}{}{ 0[0]}}\fi
    \xint_orthat{ 0[0]}%
