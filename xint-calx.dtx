% \subsection{Rounding}
% \subsubsection{\csh{CALX_fround}, \csh{CALX_fnround}, \csh{CALX_fblocks}}
%\begin{lverb}
% Syntax (use with \romannumeral0; the second argument is f-expanded):
%(
%  \CALX_fround{P}{X}<rest>   -> <space>Y\xint:<rest>
%:  \CALX_fnround{P}{X}<rest>  -> <space>Y<rest>
%:  \CALX_fblocks{m}{X}<rest>  -> <space>Y<rest>
%)
% P (number of significant digits, >= 1) and m (number of blocks, >= 1)
% are \numexpr expressions. Values X, Y (tags F, I catcode 12):
%(
%  F<s><D>.<e>.1<b_0>!1<b_1>!...1<b_n>!    native float
%:  I+   I-   I?                              specials
%)
% s sign (+ or -), D digit count of N = b_n...b_1b_0 (D = 0: zero, no
% block), e block exponent, 8-digit blocks b_i least significant first:
% value s N 10^(8e). \CALX_fround also accepts an M value (calxint) and
% an xint raw value X: A[N] or A/B[N] (the [N] is mandatory), A and B
% integers in decimal digits without leading zeros, an optional - on A
% only, B > 0 (no decimal mark, no exponent);
% it is delimited by the \xint: that \CALX_fround appends. xintexpr.sty
% replaces the raw branch \CALX_fr_x so that X may be any xintfrac input.
% \CALX_fnround and \CALX_fblocks accept only F, I.
%
% Output Y: F input: X rounded to P significant digits (\CALX_fblocks: to
% its m top blocks), round half away from zero (as xint's \xintDSRr,
% \XINTinFloat); D <= P: X itself. I input: X itself. Raw input: the F
% value of X rounded to P digits. \CALX_fround's Y is ALWAYS followed by
% \xint: (the terminator that the entries of the operations read after a
% value); \CALX_fnround and \CALX_fblocks add nothing. Only the blocks
% below the rounding position are read: the higher ones stay in the input
% stream untouched.
%
% k = D - P <= 0: unchanged (zero, specials too). Else k = 8a + c: skip
% a blocks (gobblers \CALX_fr_g<a>, a <= 5; beyond, \CALX_fr_sk drops
% seven at a time and \CALX_fr_q<r> the rest), then c > 0: lowest kept
% block 1v -> 1v/10^c*10^c (\numexpr rounds half away from zero); c = 0:
% the first digit of the last dropped block decides +1 on the lowest kept
% block. D' = D - 8a, e' = e + a.
% Dispatch on k by \csname (macros \CALX_fr_k<k>, k in decimal, k <= 0
% gives \CALX_fr_k0 = \CALX_fr_id), general path \CALX_fr_kgen beyond 47.
% \CALX_fblocks{m} is the rounding with
% k = 8(ceil(D/8) - m); ceil(D/8) = (D+3)/8 in \numexpr.
%
% \CALX_fr_w <new block>!{s}{D'}{e'}: block 200000000: carry
% (\CALX_fr_cy); D' <= 8 (the kept block is the top block): the digit
% count grows by one if the top block reaches 10^D' (\CALX_fr_top).
% The carry path grabs the kept blocks (count known from D') up to the top
% one, since the header precedes the blocks; it is rare.
%
% Dispatch (\CALX_fr_a) on the first token of X, rarest cases first, one
% macro per branch, P and the token put back: I (\CALX_fr_i: I with the
% sign that follows), M (\CALX_fr_m), - (raw), F (\CALX_fr_f: k = D - P,
% the tag a parameter), otherwise a digit (raw). M (the integer type of
% \xintiieval: same blocks and e as F): zero gives F+0.0. (\CALX_fr_mz);
% else \CALX_fr_mm grabs the blocks once, reads the digit count D on the
% top block (as \CALX_fmx_c) and \CALX_fr_mn rounds F<s><D>.<e>.<blocks>.
% Raw (\CALX_fr_x, A[N] or A/B[N]): split at the bracket only, P put
% behind (A/.P.N]); \CALX_fr_xs: the token after the first slash is the
% dot exactly when there is no slash, \xint_gob_til_dot selects. A[N]
% (\CALX_fr_xa): \CALX_ffr_a gives the exact F value of A 10^N, rounded
% by \CALX_fr_f. A/B[N] (\CALX_fr_xf): two tokens decide B = 1 (1 then
% the slash: jumper \CALX_fr_xo to \CALX_fr_xa); else \CALX_fr_xg, the
% exact F values of A 10^N and of B, and \CALX_fr_xk dispatches by
% \csname to calxfp's division: \CALX_fd_zz (B = 0: 0/0
% DivisionUndefined, x/0 DivisionByZero), \CALX_fd_zero (A = 0) or the
% generic division path \CALX_fd_g, valid for any digit counts (the
% truncated quotient has at least P + 1 digits: round half away from zero
% is that of A 10^N / B). The \xint: appended by \CALX_fround stays in
% the stream on all paths.
% xintexpr.sty redefines \CALX_fr_x with xintfrac's \XINTinFloat, which
% parses any xintfrac input.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_fround #1#2{\expandafter\CALX_fr_a\the\numexpr#1\expandafter.%
    \romannumeral`&&@#2\xint:}%
\def\CALX_fnround #1#2{\expandafter\CALX_fr_a\the\numexpr#1\expandafter.%
    \romannumeral`&&@#2}%
\def\CALX_fr_a #1.#2%
{%
    \if I#2\xint_dothis\CALX_fr_i\fi
    \if M#2\xint_dothis\CALX_fr_m\fi
    \if -#2\xint_dothis\CALX_fr_x\fi
    \if F#2\xint_dothis\CALX_fr_f\fi
    \xint_orthat\CALX_fr_x #1.#2%
}%
\def\CALX_fr_i #1.#2{ I}%
\def\CALX_fr_f #1.#2#3#4.{\expandafter\CALX_fr_b\the\numexpr#4-#1.#3#4.}%
\def\CALX_fr_m #1.#2#3#4.%
{%
    \ifnum#4=\xint_c_ \expandafter\CALX_fr_mz\fi
    \CALX_fr_mm #1.#3#4.%
}%
\def\CALX_fr_mz\CALX_fr_mm #1\xint:{ F+0.0.\xint:}%
\def\CALX_fr_mm #1.#2#3.#4.#5\xint:%
{%
    \expandafter\CALX_fr_mn\the\numexpr\xint_c_viii*(#3-\xint_c_i)%
      +\CALX_nskip\CALX_fm_gl #3-\xint_c_i.#5\xint:.#1.#2#4.#5\xint:
}%
\def\CALX_fr_mn #1.#2.#3{\expandafter\CALX_fr_b\the\numexpr#1-#2.#3#1.}%
\def\CALX_fr_x #1.#2[{\CALX_fr_xs #2/.#1.}%
\def\CALX_fr_xs #1/#2%
   {\xint_gob_til_dot #2\CALX_fr_xa.\CALX_fr_xf #1/#2}%
\def\CALX_fr_xa.\CALX_fr_xf#1/.#2.#3]%
   {\expandafter\CALX_fr_f\the\numexpr#2\expandafter.%
    \romannumeral0\CALX_ffr_a#1[#3]\xint:}%
\def\CALX_fr_xf #1/#2#3%
{%
    \if1#2\if/#3\CALX_fr_xo\fi\fi
    \CALX_fr_xg #1/#2#3%
}%
\def\CALX_fr_xo\fi\fi\CALX_fr_xg #1/#2#3{\fi\fi\CALX_fr_xa.\CALX_fr_xf #1/}%
\def\CALX_fr_xg #1/#2/.#3.#4]%
   {\expandafter\CALX_fr_xk\expanded{\romannumeral0\CALX_ffr_a#1[#4]\xint:%
    \xint:\romannumeral0\CALX_ffr_a#2[0]\xint:\xint:}{#3}}%
\def\CALX_fr_xk F#1#2.#3.#4\xint:F#5#6.#7.#8\xint:%
{%
    \csname CALX_fd_\ifnum#6=\xint_c_ zz\else\ifnum#2=\xint_c_ zero\else
      g\fi\fi\endcsname {#1}{#2}{#3}{#4}{#5}{#6}{#7}{#8}%
