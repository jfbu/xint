% \subsubsection{\csh{CALX_nsqrtrem}}
%\begin{lverb}
% Syntax (use with \romannumeral0; X f-expanded native integer or I):
%(
%  \CALX_nsqrtrem{X}  -> {S}{R}     S = isqrt(X), R = X - S^2
%)
% \CALX_nsqrtrem{X} (X f-expands to a native integer; use with
% \romannumeral0): {S}{R}, S = isqrt(X), R = X - S^2. Negative X or I-:
% InvalidOperation, {I?}{I?} (trap value {N+0.}{N+0.}); I+: {I+}{I?};
% I?: {I?}{I?} (no signal).
%
% One or two blocks: \CALX_sqrt_start (from xint) on the digits. Three blocks
% or more: X has Dg digits; K = ceil(Dg/16) = (Dg+7)/16, n' = 2K blocks;
% X is shifted by 2t digits to Dp' = 16K - o digits (o = Dg mod 2), so the
% top block has 8 - o digits, then multiplied by 4^j (j minimal, j <= 1 if
% o = 0, j <= 3 if o = 1) so that it is >= 25000000; the multiplier is
% M = 10^(2t) 4^j. If M = 1: (S,R) = core(X). Else (s,r) = core(Y) and
% S = floor(s/(2^j 10^t)), R = X - S^2 (see \CALX_nsqrt_bgh). The leading
% 8 - o digits of X come from the top block v1
% (d1 digits) and the next block v2: lead = floor((v1 B + v2)/10^e),
% e = d1 + o; floor(x/10^e) = (x+10^e/2)/10^e-1 (x >= 0).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrtrem #1{\expandafter\CALX_nsqrt_x\romannumeral`&&@#1\xint:}%
\def\CALX_nsqrt_x #1#2%
{%
    \if I#1\xint_dothis{\CALX_nsqrt_sp#2}\fi
    \if -#2\xint_dothis\CALX_nsqrt_inv\fi
    \xint_orthat\CALX_nsqrt_p
}%
\def\CALX_nsqrt_inv #1\xint:{\expandafter\CALX_ndiv_zpv\romannumeral`&&@%
    \CALX_signalcondition{InvalidOperation}{isqrt of negative or %
        special}{}{N+0.}\xint:}%
\def\CALX_nsqrt_p #1.%
{%
    \ifcase#1
         \xint_dothis\CALX_nsqrt_zero
    \or  \xint_dothis\CALX_nsqrt_pone
    \or  \xint_dothis\CALX_nsqrt_ptwo
    \fi\xint_orthat\CALX_nsqrt_big #1.%
}%
\def\CALX_nsqrt_sp #1\xint:%
{%
    \if +#1\xint_dothis{{I+}{I?}}\fi
    \if ?#1\xint_dothis{{I?}{I?}}\fi
    \xint_orthat{\CALX_nsqrt_inv\xint:}%
}%
\def\CALX_nsqrt_zero #1\xint:{{N+0.}{N+0.}}%
\def\CALX_nsqrt_pone #1.1#2!\xint:{\expandafter\CALX_nsqrt_onea\the%
    \numexpr#2.}%
\def\CALX_nsqrt_onea #1.%
   {\expandafter\CALX_nsqrt_sm\romannumeral0\expandafter\CALX_sqrt_start
    \the\numexpr\CALX_ndigs{#1}.#1.}%
\def\CALX_nsqrt_ptwo #1.1#2!1#3!\xint:{\expandafter\CALX_nsqrt_twoa\the%
    \numexpr#3.#2.}%
\def\CALX_nsqrt_twoa #1.#2.%
   {\expandafter\CALX_nsqrt_sm\romannumeral0\expandafter\CALX_sqrt_start
    \the\numexpr\xint_c_viii+\CALX_ndigs{#1}.#1#2.}%
\def\CALX_nsqrt_sm #1#2%
{%
    \expandafter\CALX_nsqrt_smb
    \the\numexpr\xint_c_ii*#1-\xint_c_i-#2\expandafter.%
    \the\numexpr#1-\xint_c_i+\xint_c_e_viii.%
}%
\def\CALX_nsqrt_smb #1.#2.%
   {\expandafter\CALX_nsqrt_ivp\romannumeral0\CALX_nsqrt_natv{#1}%
       \xint:{N+1.#2!}\CALX_nsqrt_out}%
\def\CALX_nsqrt_out #1#2{{#1}{#2}}%
\def\CALX_nsqrt_big #1.#2\xint:%
   {\CALX_nskip\CALX_nsqrt_bgt#1-\xint_c_ii.#2\xint:{#1}{#2}}%
\def\CALX_nsqrt_bgt 1#1!1#2!\xint:{\expandafter\CALX_nsqrt_bgv\the%
    \numexpr#2.#1.}%
\def\CALX_nsqrt_bgv #1.%
   {\expandafter\CALX_nsqrt_bga\the\numexpr\CALX_ndigs{#1}.#1.}%
\def\CALX_nsqrt_bga #1.#2.#3.#4%
   {\expandafter\CALX_nsqrt_bgb\the\numexpr\xint_c_viii*(#4-%
       \xint_c_i)+#1.#1.#2.#3.{#4}}%
\def\CALX_nsqrt_bgb #1.%
   {\expandafter\CALX_nsqrt_bgc\the\numexpr\ifodd#1 1\else 0\fi.#1.}%
\def\CALX_nsqrt_bgc #1.#2.#3.#4.#5.%
{%
    \expandafter\CALX_nsqrt_bgf\the\numexpr
    \ifcase\numexpr#3+#1\relax 0%
    \or #4*10000000+(#5+5)/10-\xint_c_i
    \or #4*1000000+(#5+50)/100-\xint_c_i
    \or #4*100000+(#5+500)/1000-\xint_c_i
    \or #4*10000+(#5+5000)/10000-\xint_c_i
    \or #4*1000+(#5+50000)/100000-\xint_c_i
    \or #4*100+(#5+500000)/1000000-\xint_c_i
    \or #4*10+(#5+5000000)/10000000-\xint_c_i
    \or #4%
    \or (#4+5)/10-\xint_c_i
    \fi.#1.#2.%
}%
\def\CALX_nsqrt_bgf #1.#2.#3.%
{%
    \expandafter\CALX_nsqrt_bgg\the\numexpr
    \ifnum#2=\xint_c_ \ifnum#1<25000000 1\else 0\fi
    \else\ifnum#1<1562500 3\else\ifnum#1<6250000 2\else 1\fi\fi\fi%
        \expandafter.%
    \the\numexpr16*((#3+\xint_c_vii)/16)-#2-#3\expandafter.%
    \the\numexpr\xint_c_ii*((#3+\xint_c_vii)/16).%
