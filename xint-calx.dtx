%\begin{lverb}
% Traps: none is set at load time. (The xintcore code set all eight at load
% time: \csname XINT_<name>_istrapped\endcsname.)
%
% \calxsetup$empty: the parsing loop is \bnumsetup's (bnumexpr.dtx),
% with the key dispatched through \csname CALX_setup_<key>\endcsname, one
% such macro per valid key, defined below. The value is handed over complete
% (not only its first token as in \bnumsetup) because .trap keys take a word.
% Each CALX_setup_<key> macro receives {<key as typed>}{<value>}.
%\end{lverb}
%    \begin{macrocode}
\catcode`! 3
%    \end{macrocode}
% \subsubsection{\csh{calxsetup}}
%    \begin{macrocode}
\def\calxsetup #1{\CALX_parsekeys #1,=!,}%
\def\CALX_parsekeys #1=#2,%
  {%
    \ifx!#2\expandafter\CALX_parsedone\fi
    \ifcsname CALX_setup_\xint_zapspaces #1 \xint_gobble_i\endcsname
      \xint_dothis{\csname CALX_setup_\xint_zapspaces #1 \xint_gobble_i%
          \endcsname}%
    \fi
    \xint_orthat{\CALX_setup_badkey}{#1}{#2}%
    \CALX_parsekeys
  }%
\def\CALX_parsedone #1\CALX_parsekeys {}%
\catcode`! 12
\def\CALX_settrap #1#2#3{%
    \ifnum\xintstrcmp{\xint_zapspaces #3 \xint_gobble_i}{true}=\xint_c_
      \XINT_global\expandafter\let\csname CALX_#1_istrapped\endcsname\relax
      \CALX_setup_info{trap set for signal #1}%
    \else
    \ifnum\xintstrcmp{\xint_zapspaces #3 \xint_gobble_i}{false}=\xint_c_
      \XINT_global\expandafter\let\csname CALX_#1_istrapped\endcsname%
          \XINT_undefined
      \CALX_setup_info{trap removed for signal #1}%
    \else
      \CALX_setup_error{value \detokenize{#3} of key \detokenize{#2}
                        is neither true nor false}%
    \fi\fi
}%
\def\CALX_sethandler #1#2#3{%
    \XINT_global\expandafter\let\csname CALX_#1.handler\endcsname=#3%
    \CALX_setup_info{\string#3 assigned as handler of condition #1}%
