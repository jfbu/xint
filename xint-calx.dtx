% \subsection{Native power}
%\begin{lverb}
% Syntax (use with \romannumeral0; k a \numexpr expression, k >= 0; X
% f-expanded native integer, not I):
%(
%  \CALX_npow{k}{X}  -> <space>N<s><n>.<blocks>    (X^k; X^0 = 1)
%)
% Binary powering, least significant bit of k first. The even low bits of
% k only square X (\CALX_npow_e); at the first odd bit the accumulator is
% the current base itself (no multiplication by 1), then \CALX_npow_l
% squares the base and multiplies it into the accumulator for each further
% bit, the last squaring being skipped. The new base and accumulator are
% computed inside one \expanded and handed over as braced groups.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_npow #1#2%
   {\expandafter\CALX_npow_a\the\numexpr#1\expandafter.%
    \romannumeral`&&@#2\xint:}%
\def\CALX_npow_a #1.#2\xint:%
   {\ifnum#1=\xint_c_ \xint_dothis{ N+1.100000001!}\fi
    \xint_orthat{\CALX_npow_e #1.{#2}}}%
\def\CALX_npow_e #1.#2%
{%
    \ifnum#1=\xint_c_i \xint_dothis{ #2}\fi
    \ifodd#1 \xint_dothis{\expandafter\CALX_npow_l
      \the\numexpr(#1-\xint_c_i)/\xint_c_ii\expandafter.%
      \expandafter{\romannumeral0\CALX_nmul{#2}{#2}}{#2}}\fi
    \xint_orthat{\expandafter\CALX_npow_e\the\numexpr#1/\xint_c_ii%
      \expandafter.\expandafter{\romannumeral0\CALX_nmul{#2}{#2}}}%
}%
\def\CALX_npow_l #1.#2#3%
{%
    \ifnum#1=\xint_c_i \xint_dothis{\CALX_nmul{#3}{#2}}\fi
    \ifodd#1 \xint_dothis{\expandafter\CALX_npow_l
      \the\numexpr(#1-\xint_c_i)/\xint_c_ii\expandafter.%
      \expanded{{\romannumeral0\CALX_nmul{#2}{#2}}%
                {\romannumeral0\CALX_nmul{#3}{#2}}}}\fi
    \xint_orthat{\expandafter\CALX_npow_l\the\numexpr#1/\xint_c_ii%
      \expandafter.\expandafter{\romannumeral0\CALX_nmul{#2}{#2}}{#3}}%
}%
%    \end{macrocode}
% \subsection{Native partial factorial and factorial}
%\begin{lverb}
% Syntax (use with \romannumeral0; a, b \numexpr expressions, 0 <= a < b <
% 10^8, k = 1 .. 10^4, not checked):
%(
%  \CALX_npfac{a}{b}  -> <space>N+<n>.<blocks>    ((a+1)(a+2)...b)
%:  \CALX_nfac{k}      -> <space>N+<n>.<blocks>    (k! = pfac(0, k))
%)
% The accumulator is a block list, least significant first, terminated by
% 1;!; each step multiplies it by one block y < 10^8, a product of four
% (factors <= 98), three (<= 463), two (<= 9999) or one consecutive
% integers, with \CALX_smallmul, inside one \numexpr chain which puts the
% new list in place. The last step (one to four factors, \CALX_pfac_end_..)
% hands the list to \CALX_nnorm (count, header): the kernel never produces
% a zero top block.
%\end{lverb}
%\begin{lverb}
% Moved here from xint.sty with release 1.2 (to be usable by \bnumexpr).
%
% Partially rewritten with release 1.2 to benefit from the inner format of the
% 1.2 multiplication.
% 
% With current default settings of the etex memory and a.t.t.o.w (11/2015) the
% maximal possible computation is 5971! (which has 19956 digits).
%
%
%
% Note (end november 2015): I also tried out a quickly written recursive
% (binary split) implementation
%
%( \catcode`_ 11
%: \catcode`^ 11
%: \long\def\xint_firstofthree  #1#2#3{#1}$%
