% \subsection{Raw input of the float operations}
%\begin{lverb}
% Syntax (as in calxfp, where \CALX_fr_x is the raw input branch of
% \CALX_fround):
%(
%  \CALX_fr_x <P>.<X>\xint:
%:      -> <space>Y\xint:   (Y: X rounded to P digits, native float)
%)
% calxfp accepts as raw values only A[N], A/B[N] (integers A, B without
% leading zeros, B > 0). With xintexpr.sty, X is any xintfrac
% input, as in xint 1.4: the arguments of macros made by \xintNewExpr and
% similar, the argument of qfloat() and the arguments of the \calxFp
% macros are not parsed by the expression parser. xintfrac's \XINTinFloat
% rounds X to P digits (its A[N] branch does not look for a decimal mark
% or an exponent), \CALX_ffromraw converts the A[N] result, and calxfp's
% \CALX_fr_f finishes as for a native input.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_fr_x #1.#2\xint:%
   {\expandafter\CALX_fr_f\the\numexpr#1\expandafter.%
    \romannumeral`&&@\CALX_ffromraw{\XINTinFloat[#1]{#2}}\xint:}%
