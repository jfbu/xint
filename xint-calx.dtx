%    \end{macrocode}
% \subsubsection{\csh{CALX_nsqrt_kq}}
%\begin{lverb}
% Multiply-subtract and new remainder. \CALX_nsqrt_kq clamps q* to B - 1
% (the root block is at most B - 1, and W - (B - 1) t < B^(k+1) still fits
% the window), then \CALX_nsqrt_kqa runs \CALX_ndms_a on L with q*: the
% output is 1t_0!1u_0!...1t_k!1u_k!1;;;;;!{fin} with u = W - q* t. If
% fin < 0, t is added back (\CALX_ndab) and q* decreases by one
% (\CALX_nsqrt_kp, _kpa, _kpc).
%
% \CALX_nsqrt_kw computes r' = u B + a0 - q^2 on the two low blocks: with
% qh, ql the halves of q and c = 2 qh ql = ch 10^4 + cl, the low block is
% a0 - ql^2 - cl 10^4 (borrow b0 in {-2, -1, 0}) and the next one
% u_0 - qh^2 - ch + b0 (borrow b1 in {-2, -1, 0}); further blocks are
% u_1, ..., u_k.
%
% If b1 < 0 the borrow is propagated into u_1, u_2, ... (\CALX_nsqrt_kbs,
% \CALX_nsqrt_kbt). If it runs past u_k, r' < 0 (this happens for near
% squares, e.g. 10^48 + 10^24): the step is redone from \CALX_nsqrt_kqa
% with q - 1 (\CALX_nsqrt_kfb); then u >= t >= B^k and r' >= 0. The data
% of the step, {<a1>}{<a0>}{P}, is carried along for this purpose.
%
% New state (\CALX_nsqrt_kwh): t' = t B + 2q has the blocks
% 2q - c B, t_0 + c (c = 1 if 2q >= B, else 0; t_0 is even, no carry),
% t_1, ..., t_k; r' has the blocks computed above, then u_1, ..., u_k. So
% P' = 1t'_0!1r'_0!1t'_1!1r'_1! followed by the output of the pass
% without its first two blocks.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_kq #1.#2.#3.#4.#5.#6#7#8#9%
{%
    \expandafter\CALX_nsqrt_kqa\the\numexpr
      \ifnum#3>99999999 199999999\else\xint_c_e_viii+#3\fi\xint:#7{#8}{#9}%
}%
\def\CALX_nsqrt_kqa 1#1#2#3#4#5\xint:#6#7#8#9%
{%
    \expandafter\CALX_nsqrt_kp\the\numexpr
    \CALX_ndms_a 0\xint:#1#2#3#4%
        \xint:#5!1#7!#9{#1#2#3#4#5}{#6}{#8}{{#7}{#8}{#9}}%
}%
\def\CALX_nsqrt_kp #1;;;;;!#2%
{%
    \ifnum\numexpr#2<\xint_c_ \xint_dothis\CALX_nsqrt_kpa\fi
    \xint_orthat\CALX_nsqrt_kw #1;;;;;!%
}%
\def\CALX_nsqrt_kpa #1;;;;;!%
   {\expandafter\CALX_nsqrt_kpc\the\numexpr\CALX_ndab 0\xint:#1;;;;;!}%
\def\CALX_nsqrt_kpc #1;;;;;!#2{\CALX_nsqrt_kw #1;;;;;!{#2-\xint_c_i}}%
\def\CALX_nsqrt_kw 1#1!1#2!#3;;;;;!#4#5#6#7%
{%
    \expandafter\CALX_nsqrt_kwa\the\numexpr#4\expandafter.%
    \the\numexpr(#4+5000)/\xint_c_e_iv-\xint_c_i.#1.#2.#6.{#5}{#7}#3;;;;;!%
}%
\def\CALX_nsqrt_kwa #1.#2.%
   {\expandafter\CALX_nsqrt_kwb\the\numexpr\xint_c_ii*#2*(#1-#2*%
       \xint_c_e_iv).#1.#2.}%
\def\CALX_nsqrt_kwb #1.%
   {\expandafter\CALX_nsqrt_kwc\the\numexpr(#1+5000)/\xint_c_e_iv-%
       \xint_c_i.#1.}%
\def\CALX_nsqrt_kwc #1.#2.#3.#4.#5.#6.#7.%
{%
    \expandafter\CALX_nsqrt_kwd
    \the\numexpr#7-(#3-#4*\xint_c_e_iv)*(#3-#4*\xint_c_e_iv)
                -(#2-#1*\xint_c_e_iv)*\xint_c_e_iv\expandafter.%
    \the\numexpr#6-#4*#4-#1.#3.#5.%
}%
\def\CALX_nsqrt_kwd #1.%
   {\expandafter\CALX_nsqrt_kwe\the\numexpr(#1+250000000)/\xint_c_e_viii-%
       \xint_c_iii.#1.}%
\def\CALX_nsqrt_kwe #1.#2.#3.%
   {\expandafter\CALX_nsqrt_kwf\the\numexpr#3+#1\expandafter.\the%
       \numexpr#2-#1*\xint_c_e_viii.}%
\def\CALX_nsqrt_kwf #1.%
   {\expandafter\CALX_nsqrt_kwg\the\numexpr(#1+150000000)/\xint_c_e_viii-%
       \xint_c_ii.#1.}%
\def\CALX_nsqrt_kwg #1.#2.#3.#4.#5.%
{%
    \ifnum#1=\xint_c_ \expandafter\CALX_nsqrt_kwh\else\expandafter%
        \CALX_nsqrt_kwp\fi
    {#1}{#2}{#3}{#4}{#5}%
