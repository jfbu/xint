% \subsection{Native division}
% \subsubsection{\csh{CALX_nudiv}}
%\begin{lverb}
% Division (calx). Unsigned core:
%( \CALX_nudiv <cont>{na}{A}{nb}{B}
%)
% with A, B non zero, given by their block counts and LS-first blocks.
% It expands to
%( <cont>{nq}{Q}{s}{R'}
%)
% where nq, Q (count, LS-first blocks) is the quotient floor(A/B), and R'
% the LS-first blocks (non normalized: zero top blocks possible) terminated
% by 1;! of 10^s times the remainder R = A - Q*B. Use \CALX_nudiv_rem to get
% R in native format. The tokens following the last argument are left
% untouched after <cont>{nq}{Q}{s}{R'}.
%
% Paths:
%- na < nb: Q = 0, R' = A, s = 0.
%- nb = 1, na = 1: \numexpr.
%- nb = 1, divisor d <= 45249: dedicated kernel (see below).
%- nb = 1, larger divisor: A reversed (\CALX_rev_nounsep),
% \CALX_smalldivx_a (from xintcore) (MS-first), quotient reversed.
%- nb = 2, 3, 4: dedicated loops without normalization (see below), s = 0.
%- nb >= 5: Knuth's algorithm D in base 10^8, described now.
%
% Algorithm D (general path).
%
% Normalisation: s = number of leading zeros of the top block of B (as an
% 8 digit block); A'' = 10^s A with exactly na+1 blocks (a zero block is
% appended before multiplying), B' = 10^s B (nb blocks, top block v1 >=
% 10^7). \CALX_smallmul (from xintcore) does both products, LS-first.
% The quotient is the same, the remainder is multiplied by 10^s.
%
% Data: the window W (nb+1 blocks w_0..w_nb, W < 10^8 B') and B' (b_0 ..
% b_{nb-1}) are kept INTERLEAVED in one list
%( L = 1w_0!1b_0!1w_1!1b_1!...1w_{nb-1}!1b_{nb-1}!1w_nb!1;;;;;!
%)
% (1;;;;;! = marker Z). The remaining blocks of A'' are kept MS-first in the
% input stream, after L, terminated by 1;!.
%
% The multiply-subtract pass \CALX_ndms_a reads the pairs (w_k,b_k) and emits
% b_k then r_k, where r = W - q*B' (one borrow chain); its output is
%( 1b_0!1r_0!1b_1!1r_1!...1b_{nb-1}!1r_{nb-1}!1;;;;;!{fin}
%)
% with fin = 0 if r >= 0 and fin = -1 if r < 0 (then the blocks hold
% r + 10^(8nb)). Prefixing the next block of A'' gives exactly the next
% window in the layout of L: pairs (new,b_0), (r_0,b_1), ..., top
% (r_{nb-1},Z).
%
% Estimation of q (with u0, u1, u2 the three top blocks of W, v1, v2 those
% of B', U = u0 b^2+u1 b+u2, V = v1 b+v2, b = 10^8): q* = min(floor(U/V),
% b-1) satisfies q <= q* <= q+1. Indeed W/B' < (U+1)/V gives q <=
% floor(U/V), and W/B' >= U/(V+1) gives q >= floor(U/(V+1)) >= floor(U/V)-1
% as U/V - U/(V+1) = U/(V(V+1)) < 1 (U < b V, V >= b). This holds for any
% v1 > 0; q* = q+1 needs the lower blocks to matter (probability about
% 1/v1). q* is obtained from
%( q0 = round(u0*10^9/Vp) + round(u1d/Vp),
%)
% where Vp = 10 v1 + first digit of v2 (9 digits) and u1d = 10 u1 + first
% digit of u2 (eTeX's a*b/c has a 64 bit intermediate product), clamped to
% [0, b-1]; then T = U - q0 V is computed exactly as T = a b + c with
% 0 <= c < b, by splitting q0 and v1, v2 in 4 digit halves, and corrected:
%( while T < 0: q0 -= 1, T += V;
%: while T >= V and q0 < b-1: q0 += 1, T -= V.
%)
% (|q0 - U/V| < 2.1, so at most three corrections.)
%
% If fin < 0 after the pass, B' is added back (\CALX_ndab) and q decreases.
%
% The quotient blocks are left behind in a \numexpr chain (xintcore's
% technique, value 10^8+q emitted by the enclosing \numexpr), MS-first, and
% reversed once at the end.
%\end{lverb}
%    \begin{macrocode}
