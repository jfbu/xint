% \subsection{Exceptional conditions: signals, flags, handlers, traps}
% The code of this section comes from the unfinished signal code of
% |xintcore.sty| (dating back to |1.2l|), renamed, kept in the core module,
% and completed.
%\begin{lverb}
% As per the Mike Cowlishaw/IBM's General Decimal Arithmetic Specification
%
%    http://speleotrove.com/decimal/decarith.html
%
% and the Python3 implementation in its Decimal module.
%
% Clamped, ConversionSyntax, DivisionByZero, DivisionImpossible,
% DivisionUndefined, Inexact, InsufficientStorage, InvalidContext,
% InvalidOperation, Overflow, Inexact, Rounded, Subnormal,
% Underflow.
%
% X3.274 rajoute LostDigits
%
% Python rajoute FloatOperation (et n'inclut pas InsufficientStorage)
%
% quote de decarith.pdf:
% The Clamped, Inexact, Rounded, and Subnormal conditions can coincide with
% each other or with other conditions. In these cases then any trap enabled
% for another condition takes precedence over (is handled before) all of
% these, any Subnormal trap takes precedence over Inexact, any Inexact trap
% takes precedence over Rounded, and any Rounded trap takes precedence over
% Clamped.
%
% This was initiated at 1.2l (2017/07/26), but the possibility to
% customize handlers was never finished nor documented for users.
% Completely redone for 2.0a1 (2026/11/01).
%
% Model: the decimal module of Python (as for the xintcore code), with the
% IEEE 754 default
% exception handling as default configuration: a condition raises a flag and
% is handled, the handler returns a default result, and NO TeX error is
% emitted. Emitting an (expandable) error is an opt-in, per signal, via
% \calxsetup.
%
% Vocabulary (that of Python's decimal module):
%- a CONDITION is what a calx macro detects and reports;
%- each condition belongs to a SIGNAL; for most conditions, condition and
% signal are the same; five conditions belong to signal InvalidOperation:
%( ConversionSyntax        (input which is not a number)
%: DivisionImpossible      (integer division result does not fit)
%: DivisionUndefined       (0/0)
%: InvalidContext          (invalid configuration)
%: ControversialOperation  (argument too large for a periodic function)
%)
%- there are eight signals: Clamped, DivisionByZero, Inexact,
% InvalidOperation, Overflow, Rounded, Subnormal, Underflow;
%- each SIGNAL has a FLAG (raised or not) and a TRAP (set or not);
%- each CONDITION has a HANDLER.
%
% What happens when calx code signals a condition C of signal S, via
%( \CALX_signalcondition{C}{<message>}{<handler argument>}{<trap value>}
%)
% (this is \CALX_signalcondition_a below, Python's Context._raise_error):
%- 1. if S is "ignored" (control sequence \CALX_S_isignoredflag defined;
% Python's Context._ignored_flags), the handler of S is applied to
% <handler argument>, and that is all: no flag is raised;
%- 2. otherwise the flag of S is raised; then
%- 3. if S is not trapped (the default for all signals), the handler of C is
% applied to <handler argument>, and its result is the result;
%- 4. if S is trapped, an expandable error is emitted with <message>, and the
% result is <trap value>, the value the calling macro would return
% without the signal machinery (e.g. what xint returns: 0 on division by
% zero).
%
% No calx code sets the "ignored" status at this stage; it is kept from
% the xintcore code (and Python) for internal computations which must not
% leave traces in the flags. It is set by \let\CALX_S_isignoredflag\relax (via
% \csname) and cleared by \let to \XINT_undefined.
%
% Default handlers (Python's decimal: the "handle" method of each condition
% class; a class without "handle" returns None in Python, meaning the caller
% keeps the result it has computed, which here is the handler argument):
%( condition          handler argument           result
%: ------------------------------------------------------------------
%: InvalidOperation   (ignored)                  I?        (NaN)
%: ConversionSyntax   (ignored)                  I?
%: DivisionImpossible (ignored)                  I?
%: DivisionUndefined  (ignored)                  I?
%: InvalidContext     (ignored)                  I?
%: ControversialOperation (ignored)              I?
%: DivisionByZero     sign + or -                I+ or I-  (+-Infinity)
%: Overflow           sign + or -                I+ or I-
%: Underflow          computed result            the argument
%: Clamped            computed result            the argument
%: Inexact            computed result            the argument
%: Rounded            computed result            the argument
%: Subnormal          computed result            the argument
%)
% I, ?, + and - in results are catcode 12 characters, the special value
% markers of the calx internal format (I+ is +Infinity, I- is -Infinity, I?
% is NaN). The sign handed to the DivisionByZero and Overflow handlers must be
% a catcode 12 + or -. Printing the special values as NaN, Infinity,
% -Infinity is not done here: it is the task of the output macros of the
% arithmetic modules.
%
% Overflow: Python returns +-Infinity or the largest finite number, depending
% on the rounding mode. calx rounds half away from zero, for which Python
% (ROUND_HALF_UP) returns +-Infinity.
%
% FLAGS. A flag of signal S is raised when \CALX_SFlag_ON is defined. It is
% raised EXPANDABLY by
%( \expandafter\xint_gobble_i\csname CALX_SFlag_ON\endcsname
%)
% which uses the fact that \csname...\endcsname, if the name is undefined,
% \let's it to \relax as a side effect. This assignment is ALWAYS LOCAL to
% the current group (checked under etex: even with \globaldefs=1). Hence:
%- a flag raised by a computation done inside a group (\begingroup or braces,
% an \hbox, an alignment cell, ...) is down again after the group ends;
%- a flag is raised only when the computation is actually expanded: inside
% an \edef, an \expanded, a \message, a \csname, or f-expansion; storing
% an unexpanded computation in a macro via \def raises nothing.
%
% A user wanting a flag to survive a group tests it before the group ends
% and makes the information global by his own means.
%
% Testing (expandable) and lowering (NOT expandable):
%( \calxifflagraised{S}{<yes>}{<no>}
%: \calxresetflag{S}
%: \calxresetflags   (the eight flags)
%)
% Lowering obeys \ifxintglobaldefs (via \XINT_global): it is global if
% \xintglobaldefstrue, local otherwise.
%
% CONFIGURATION, \calxsetup. Same syntax and method as \bnumsetup of bnumexpr:
% a comma separated list of key=value; spaces around keys are
% removed; a final comma does no harm; each key performs a \let; assignments
% are global if \xintglobaldefstrue, local otherwise (\XINT_global); with
% \xintverbosetrue each assignment is reported on the terminal and in the log
% (\xintMessage).
%
% Keys:
%( <S>.trap    = true   (or false)           for each of the eight signals
%: <C>.handler = \macro                      for each of the thirteen conditions
%)
% e.g.
%( \calxsetup{DivisionByZero.trap = true, InvalidOperation.trap = true}
%)
% gives back the behaviour of xint (expandable error, then xint's default
% result) for these two signals.
%
% A handler is a macro with ONE argument, the handler argument; it must
% expand to the result (in the contexts where calx macros use it, it is
% expanded by f-expansion). For example a user preferring that conversion
% errors give zero, in the calx internal format of zero, would \let the
% ConversionSyntax handler to a macro expanding to that. The value of
% <C>.handler must be a single control sequence (the \let receives only
% that).
%
% An unknown key, or a value other than true and false for a .trap key, is
% reported by a (non expandable) TeX error, \calxsetup being itself not
% expandable.
%\end{lverb}
%    \begin{macrocode}
\catcode`- 11
\def\CALX_ConversionSyntax-signal  {{InvalidOperation}}%
\let\CALX_DivisionImpossible-signal\CALX_ConversionSyntax-signal
\let\CALX_DivisionUndefined-signal \CALX_ConversionSyntax-signal
\let\CALX_InvalidContext-signal    \CALX_ConversionSyntax-signal
\let\CALX_ControversialOperation-signal\CALX_ConversionSyntax-signal
\catcode`- 12
%    \end{macrocode}
% \subsubsection{\csh{CALX_signalcondition}}
%\begin{lverb}
% Syntax (f-expandable):
%(
%  \CALX_signalcondition{C}{M}{H}{V}  -> <result>
%)
% C a signal or condition name (InvalidOperation, DivisionByZero, ...),
% M the error message, H the handler argument, V the value returned if the
% signal is trapped; <result>: the handler's value (or V).
%
% \CALX_signalcondition$empty: identical to \XINT_signalcondition
% (xintcore.sty of xint 1.4p), renamed. The first \romannumeral0 step turns
% #1 into {<signal>}{<condition>}, then \CALX_signalcondition_a receives
%( #1 = signal, #2 = condition, #3 = error message,
%: #4 = handler argument, #5 = value returned if the signal is trapped.
%)
% Note that, as in Python, the "ignored" branch applies the handler of the
% SIGNAL, the untrapped branch the handler of the CONDITION.
%
% The expansion is complete (handler included) under f-expansion. The handlers
% defined here expand in one step to their result.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_signalcondition #1{\expandafter\CALX_signalcondition_a
    \romannumeral0\ifcsname CALX_#1-signal\endcsname
                    \xint_dothis{\csname CALX_#1-signal\endcsname}%
                  \fi\xint_orthat{{#1}}{#1}}%
\def\CALX_signalcondition_a %
    #1#2#3#4#5{% copied over from Python Decimal module
\ifcsname CALX_#1_isignoredflag\endcsname
       \xint_dothis{\csname CALX_#1.handler\endcsname {#4}}%
    \fi
    \expandafter\xint_gobble_i\csname CALX_#1Flag_ON\endcsname
    \unless\ifcsname CALX_#1_istrapped\endcsname
       \xint_dothis{\csname CALX_#2.handler\endcsname {#4}}%
    \fi
    \xint_orthat{%
       % the flag raised is named after the signal #1, but we show condition
       % #2
       \XINT_expandableerror{#3}%
       \xint_firstofone{#5}%
    }%
}%
\let\XINT_signalcondition\CALX_signalcondition
%    \end{macrocode}
%\begin{lverb}
% Flags. \CALX_RaiseFlag is xintcore's \XINT_RaiseFlag, for direct use by calx
% code (raising a flag without going through a handler). The public test and
% reset macros are xintcore's \XINT_ifFlagRaised, \XINT_resetFlag,
% \XINT_resetFlags made public; the reset obeys \XINT_global, and resets all
% eight flags (the xintcore version listed four).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_RaiseFlag #1{\expandafter\xint_gobble_i\csname CALX_#1Flag_ON%
    \endcsname}%
%    \end{macrocode}
% \subsubsection{\csh{calxifflagraised}, \csh{calxresetflag},
% \csh{calxresetflags}}
%    \begin{macrocode}
\def\calxifflagraised #1{%
    \ifcsname CALX_#1Flag_ON\endcsname
        \expandafter\xint_firstoftwo
    \else
        \expandafter\xint_secondoftwo
    \fi}%
