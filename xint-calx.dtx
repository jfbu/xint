\CALX_tmpa{InvalidOperation}\CALX_tmpa{Overflow}\CALX_tmpa{Rounded}%
\CALX_tmpa{Subnormal}\CALX_tmpa{Underflow}%
\def\CALX_tmpa #1{%
    \expandafter\def\csname CALX_setup_#1.handler\endcsname{%
        \CALX_sethandler{#1}}%
}%
\CALX_tmpa{Clamped}\CALX_tmpa{DivisionByZero}\CALX_tmpa{Inexact}%
\CALX_tmpa{InvalidOperation}\CALX_tmpa{Overflow}\CALX_tmpa{Rounded}%
\CALX_tmpa{Subnormal}\CALX_tmpa{Underflow}%
