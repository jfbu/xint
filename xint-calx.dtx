% \XINT_CosAux_b (Horner in \numexpr, 9-digit fixed point).
%\end{lverb}
%    \begin{macrocode}
\def\XINT_SinAux_b#1.%
{%
  ((((((((%
  -#1/110+\xint_c_e_ix)/%
  -72)*#1/\xint_c_e_ix+\xint_c_e_ix)/%
  -42)*#1/\xint_c_e_ix+\xint_c_e_ix)/%
  -20)*#1/\xint_c_e_ix+\xint_c_e_ix)/%
  -6)*#1/\xint_c_e_ix+\xint_c_e_ix
}%
\def\XINT_CosAux_b#1.%
{%
  ((((((((((%
  -#1/132+\xint_c_e_ix)/%
  -90)*#1/\xint_c_e_ix+\xint_c_e_ix)/%
  -56)*#1/\xint_c_e_ix+\xint_c_e_ix)/%
  -30)*#1/\xint_c_e_ix+\xint_c_e_ix)/%
  -12)*#1/\xint_c_e_ix+\xint_c_e_ix)/%
  -2)*#1/\xint_c_e_ix+\xint_c_e_ix
}%
%    \end{macrocode}
