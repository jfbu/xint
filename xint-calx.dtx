%\subsection{The calx layer}
%\begin{lverb}
% calx: native float operators (wip).
% ATTENTION: the ! has catcode 12 here due to prior \XINTsetcatcodes.
%
% ATTENTION: we do NOT set catcode of M (or N, or F) to 12 here.
%            They only appear in \if tests, and are needed in macro
%            names.
%
% Operator-level macros (letter-only names, frozen in user functions):
% two arguments (one for Sqr, Opp), precision \XINTdigits at run time.
%
% Syntax (all f-expandable; arguments f-expanded, F, I or raw values; P =
% \XINTdigits unless given; results F or I values, without leading space):
%(
%  \calxFpAdd{X}{Y}, \calxFpSub, \calxFpMul, \calxFpDiv  -> round_P(X op Y)
%:  \calxFpMulExact{X}{Y}                -> X Y exact (X, Y finite F)
%:  \calxFpDivFloor{X}{Y}               -> floor(X'/Y') exact (X' = round_P(X))
%:  \calxFpMod{X}{Y}                    -> round_P(X' - Y' floor(X'/Y'))
%:  \calxFpDivMod{X}{Y}                 -> {floor(X'/Y')}{round_P(X' mod Y')}
%:  \calxFpInv{X}                       -> round_P(1/X)  (X exact)
%:  \calxFpE{X}{n}                      -> round_P(X) 10^n  (raw A[N])
%:  \calxFpSum{X1}...{Xn}^, \calxFpPrd  -> (((X1 op X2) op X3) ...), each op
%:                                       rounded (+(), *(); empty: 0, 1)
%:  \calxFpSqr{X}, \calxFpSqrtdigits{X}  -> round_P(X^2), round_P(sqrt X)
%:  \calxFpSqrt[P]{X}                    -> round_P(sqrt X)
%:  \calxFpOpp{X}, \calxFpAbs{X}         -> -X, |X|   (exact)
%:  \calxSgn{X}                          -> -1, 0 or 1   (any value)
%:  \calxFpLt{X}{Y}, \calxFpGt, \calxFpLtorEq, \calxFpGtorEq,
%:  \calxFpEq, \calxFpNotEq               -> 1 or 0 (exact comparison)
%:  \calxFpMaxof{X1}...{Xn}^, \calxFpMinof  -> the largest (smallest) Xi
%:  \calxFpTrunc{X}, \calxFpFloor{X}, \calxFpCeil{X}, \calxFpFrac{X}
%:                                       -> F (raw input: raw result)
%:  \calxFpITrunc{k}{X}, \calxFpIRound{k}{X}  -> trunc(X), round(X)
%:  \calxFpToNum{X}                      -> digits of trunc(X)
%)
% Internal helpers used by other files: \CALX_fcmp{X}{Y} (in \ifcase: 0
% equal, 1 greater, 2 less, 3 unordered), \CALX_fonec (native 1),
% \CALX_fopp_a (sign flip), \CALX_ti_f (calxfp: trunc of an F value
% followed by \xint:), \CALX_fcnan (InvalidOperation signal of a comparison).
%\end{lverb}
%    \begin{macrocode}
\def\calxFpAdd #1#2%
   {\romannumeral0\expandafter\CALX_fadd_in\expanded{#1\xint:#2\xint:}\the\XINTdigits.}%
\def\calxFpSub #1#2%
   {\romannumeral0\expandafter\CALX_fsub_in\expanded{#1\xint:#2\xint:}\the\XINTdigits.}%
\def\calxFpMul #1#2%
   {\romannumeral0\expandafter\CALX_fmul_in\expanded{#1\xint:#2\xint:}\the\XINTdigits.}%
\def\calxFpMulExact #1#2%
   {\romannumeral0\expandafter\CALX_fmulxs_in\expanded{#1\xint:#2\xint:}}%
\def\calxFpDiv #1#2%
   {\romannumeral0\expandafter\CALX_fdiv_in\expanded{#1\xint:#2\xint:}\the\XINTdigits.}%
\def\calxFpDivFloor #1#2%
   {\romannumeral0\expandafter\CALX_fdq_in\expanded{#1\xint:#2\xint:}\the\XINTdigits.\CALX_fdq_q}%
\def\calxFpMod #1#2%
   {\romannumeral0\expandafter\CALX_fdq_in\expanded{#1\xint:#2\xint:}\the\XINTdigits.\CALX_fdq_r}%
\def\calxFpDivMod #1#2%
   {\romannumeral0\expandafter\CALX_fdq_in\expanded{#1\xint:#2\xint:}\the\XINTdigits.\CALX_fdq_p}%
\def\calxFpInv #1%
   {\romannumeral0\expandafter\CALX_finv_in\romannumeral`&&@#1\xint:\the\XINTdigits.}%
\def\calxFpE #1%
   {\romannumeral0\expandafter\CALX_fe_in\romannumeral`&&@#1\xint:\the\XINTdigits.}%
%    \end{macrocode}
%\begin{lverb}
% calx: `+`(), `*`() of \xintfloateval: B.'s 1.4p \XINT_sum/\XINT_prd
% loops (xintfrac), \xintadd/\xintmul replaced by \CALX_fsumop/\CALX_fprdop
% (rounded to P at each step, unlike 1.4p's exact \XINT_Sum); empty: 0[0],
% 1[0]; one item: returned as it is (f-expanded).
%\end{lverb}
%    \begin{macrocode}
\def\calxFpSum {\romannumeral0\CALX_fpsum}%
\def\CALX_fpsum #1%
{%
    \xint_gob_til_^ #1\CALX_fpsum_empty ^%
    \expandafter\CALX_fpsum_loop\romannumeral`&&@#1\xint:
}%
\def\CALX_fpsum_empty ^#1\xint:{ 0[0]}%
\def\CALX_fpsum_loop #1\xint:#2%
{%
    \xint_gob_til_^ #2\CALX_fpsum_end ^%
    \expandafter\CALX_fpsum_loop
    \romannumeral0\CALX_fsumop{#1}{#2}\xint:
}%
\def\CALX_fpsum_end ^#1\CALX_fsumop #2#3\xint:{ #2}%
\def\calxFpPrd {\romannumeral0\CALX_fpprd}%
\def\CALX_fpprd #1%
{%
    \xint_gob_til_^ #1\CALX_fpprd_empty ^%
    \expandafter\CALX_fpprd_loop\romannumeral`&&@#1\xint:
}%
\def\CALX_fpprd_empty ^#1\xint:{ 1[0]}%
\def\CALX_fpprd_loop #1\xint:#2%
{%
    \xint_gob_til_^ #2\CALX_fpprd_end ^%
    \expandafter\CALX_fpprd_loop
    \romannumeral0\CALX_fprdop{#1}{#2}\xint:
}%
\def\CALX_fpprd_end ^#1\CALX_fprdop #2#3\xint:{ #2}%
\def\CALX_fsumop {\CALX_fadd\XINTdigits}%
\def\CALX_fprdop {\CALX_fmul\XINTdigits}%
\def\calxFpSqr #1%
   {\romannumeral0\expandafter\CALX_fsqr_in\romannumeral`&&@#1\xint:\the\XINTdigits.}%
\def\calxFpSqrtdigits #1%
   {\romannumeral0\expandafter\CALX_fsqrt_in\romannumeral`&&@#1\xint:\the\XINTdigits.}%
\def\calxFpSqrt [#1]#2%
   {\romannumeral0\expandafter\CALX_fsqrt_in\romannumeral`&&@#2\xint:\the\numexpr#1.}%
%    \end{macrocode}
%\begin{lverb}
% \calxFpToNum{X}: explicit digits of trunc(X), where X is a parser
% value (possibly still expandable).  The ordinary entry takes one brace
% level.  \calxListItemToNum{X} is for the legacy list selectors, whose
% items carry an additional brace level; it strips that level explicitly.
% Both paths enter the same conversion kernel, \CALX_fnum, with an
% already f-expanded input followed by \xint:.
%\end{lverb}
%    \begin{macrocode}
\def\calxFpToNum #1%
   {\romannumeral0\expandafter\CALX_fnum\romannumeral`&&@#1\xint:}%
