% x >= 10^8). 0! = 1; pfactorial is 1 if a >= b, 0 if a < 0 <= b, and
% for a < b < 0 the product of the negative factors; binomial is 0 if
% y < 0 or y > x, 1 if y = 0 or y = x.
%
