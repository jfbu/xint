%\begin{lverb}
% \calxFpAsin{X}: asin of round_P(X), P = \XINTdigits <= 100, after
% xinttrig's @asin_l. With x = |X|, u = sqrt(1 - x^2) (x^2 exact, 1 - x^2
% rounded to 2P+8 digits, square root to P+4 digits); if x > sqrt(2)/2
% (round(10^9 x) > 707106781) the roles of x and u are exchanged and the
% result is pi/2 minus the core value. Core (x <= sqrt(2)/2, y the other
% one): tau = round(10^9 x) (\CALX_as_tau), T = 10^-9 round(tau S/10^9)
% with S from the arcsine series in one \numexpr (\CALX_asb, from
% xinttrig's \XINT_Arcsin_Ib), |asin x - T| about 10^-9; then
%(
%:  D = x cos(T) - y sin(T) = sin(asin x - T),
%)
% cos(T) and sin(T) by the sin/cos kernels rounded to P+4 digits (P <=
% 32: flat path, finishers \CALX_gkA, \CALX_gkB; P > 32: series path
% \CALX_sha, finishers \CALX_shoA, \CALX_shoB), the two products exact
% (\CALX_fmulx), their difference exact (2P+24 digits);
% core = T + D, plus D^3 S(D^2) if P > 16 (S the arcsine series,
% round((P+9)/18) terms, Horner at P digits, \CALX_ash<K>), the sum
% exact. T < 10^-8: core = x + x^3/6 (P <= 16), x + x^3 S(x^2) (P > 16,
% \CALX_as_ser). x = 1: core 0, roles exchanged.
% Operations whose operands have at most the target number of digits
% use the entries without input rounding (\CALX_fsubu, \CALX_fmulu,
% \CALX_faddu, \CALX_fsqru, \CALX_fdivu); the sums and differences of
% exact values are exact (\CALX_faddx, \CALX_fsubx).
%
% \CALX_as_out{core}{n|s}{a}{b}{d}{g} (n: A = core, s: A = pi/2 - core;
% a, b integers as \numexpr text, b = +-1) gives round_P(f (a pi/2 + b
% A)) = round_P(f (k pi/2 + m core)): k = a, m = b (n) or k = a + b, m =
% -b (s). k = 0: no sum; else k pi/2 + m core exact (2P+70 digits, pi/2
% to 130 digits rounded to 2P+70). f = 1/d (d = 1 or 2) times 180/pi if
% g = 1, by \CALX_aso<2d+g-2>: 1/2 by the exact \CALX_fhalf, 180/pi by a
% product at P+8 digits; then one rounding to P. Signs by \CALX_as_m
% (product of two sign characters with the sign of a native). asin,
% asind: a = 0, b = +-1; acos, acosd: a = 1, b = -1 (x >= 0) or 1 (x <
% 0); acsc, asec: the same on y = 1/x (P+4 digits; x = 0:
% DivisionByZero), with 1 - y^2 = (x^2 - 1)/x^2 at P+4 digits from the
% exact x^2 - 1 and x^2 (\CALX_ac_b; no cancellation near |x| = 1).
%
% atan (xinttrig's @atan, no square root): t = |x|, T = t^2, z = 1/(1+T),
% w = 1 - T (P+8 digits); the core on x' = 2tz, y' = |w|z (P+4 digits,
% 2t exact; x'^2 + y'^2 = 1) gives A = 2 atan(t)
% if w > 0, pi - 2 atan(t) if w < 0 (w = 0: A = pi/2); then d = 2. Entry
% \CALX_at_a{c}{s}{g}: c pi/2 + s atan(x) (atan: c = 0, s = 1). Arg(x,y),
% pArg, atan2(y,x) and degree versions: the cases of xinttrig's @Arg,
% @pArg on the signs of y - x, y + x and y (\CALX_ar<kind><y>x><y>-x><y
% sign>), q = y/x, x/y or x/(-y) at P+4 digits, then \CALX_at_b with the
% (c, s) of the case; Arg(0,0) = 0.
%
% tan, cot, sec, csc, sinc and sind, cosd, tand, cotd, secd, cscd:
% \CALX_sc_a gives the quadrant q and the reduced argument u. Radians:
% |x| < 0.8: q = 0, u = x, else the reduction \CALX_red (|x| < 10^4) or
% \CALX_rslow; both kernels
% (\CALX_sc_k): S = sin u, C = cos u rounded to P+4 digits (finishers A
% and B; tiny u: \CALX_shzA, \CALX_shzB). Degrees: \CALX_sc_f (below);
% sind, cosd, secd, cscd compute only the one of S, C they need. Then
% the finisher \CALX_fn<f>{q}{sign}{S}{C}{x}: sin x and cos x from S, C
% by the quadrant (\CALX_scS, \CALX_scC), one division at P+4 digits,
% one rounding to P.
%
% Special values (IEEE 754 / C99 Annex F, calx zero being unsigned): NaN
% (I?) gives I?; sin, cos, tan, cot, sec, csc, the degree versions, asin,
% acos, asind, acosd of +-infinity signal InvalidOperation (I?,
% \CALX_tr_sp); sinc(+-inf) = 0; acsc(+-inf) = 0, asec(+-inf) = pi/2;
% atan(+-inf) = +-pi/2 (atand: +-90); Arg, pArg, atan2 (and degrees)
% with an infinite argument: the atan2 table of C99 (\CALX_ari<kind><y>
% <x>, classes p, m infinities, f finite >= 0, g finite < 0): +-pi/2,
% +-pi/4, +-3pi/4, 0, pi, -pi, pArg brought to [0, 2pi). Poles (tand(90),
% cot(0), ...): division by zero, signal DivisionByZero, I+ or I-.
%\end{lverb}
