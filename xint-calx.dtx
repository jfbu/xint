%\begin{lverb}
% Syntax (f-expandable; X, Y f-expanded F, I or raw values, rounded to
% P = \XINTdigits digits; results F or I values, rounded to P digits):
%(
%  \calxFp<F>{X}         -> F(X)
%:      F = Sin, Cos, Tan, Cot, Sec, Csc, Sinc (radians),
%:          Sind, Cosd, Tand, Cotd, Secd, Cscd (degrees),
%:          Asin, Acos, Asec, Acsc, Atan (radians),
%:          Asind, Acosd, Atand (degrees)
%:  \calxFpArg{X}{Y}     -> argument of (X, Y), in (-pi, pi]
%:  \calxFppArg{X}{Y}    -> the same, in [0, 2pi)
%:  \calxFpArgd{X}{Y}, \calxFppArgd{X}{Y}       -> the same in degrees
%:  \calxFpAtantwo{Y}{X}, \calxFpAtantwod{Y}{X}  -> atan2(Y, X) = Arg(X, Y)
%)
%
% \calxFpSin{X}, \calxFpCos{X}: P = \XINTdigits. X is first rounded to
% P digits, then \CALX_sin_g, \CALX_cos_g: |X| < 0.8 goes to the series
% kernels \CALX_sin_h, \CALX_cos_h, |X| >= 0.8 to the argument reduction
% (\CALX_sin_r, \CALX_cos_r) then to the same kernels. P <= 8 ("ultra
% fast, less precise", as xinttrig): \numexpr kernels
% \CALX_sin_q, \CALX_cos_q (called by \CALX_sin_h, \CALX_cos_h).
%\end{lverb}
%    \begin{macrocode}
\def\calxFpSin{\romannumeral0\expandafter\CALX_sin_a
    \romannumeral0\CALX_fround{\XINTdigits}}%
\def\calxFpCos{\romannumeral0\expandafter\CALX_cos_a
    \romannumeral0\CALX_fround{\XINTdigits}}%
\def\calxFpAsin #1{\romannumeral0\expandafter\CALX_ad_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}a0}%
\def\calxFpAcos #1{\romannumeral0\expandafter\CALX_ad_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}c0}%
\def\calxFpAsind #1{\romannumeral0\expandafter\CALX_ad_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}a1}%
\def\calxFpAcosd #1{\romannumeral0\expandafter\CALX_ad_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}c1}%
\def\calxFpAcsc #1{\romannumeral0\expandafter\CALX_ae_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}a}%
\def\calxFpAsec #1{\romannumeral0\expandafter\CALX_ae_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}c}%
\def\calxFpAtan #1{\romannumeral0\expandafter\CALX_tq_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}{0}{1}{0}}%
\def\calxFpAtand #1{\romannumeral0\expandafter\CALX_tq_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}{0}{1}{1}}%
\def\calxFpTan #1{\romannumeral0\expandafter\CALX_sc_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fntan r}%
\def\calxFpCot #1{\romannumeral0\expandafter\CALX_sc_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fncot r}%
\def\calxFpSec #1{\romannumeral0\expandafter\CALX_sc_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fnsec r}%
\def\calxFpCsc #1{\romannumeral0\expandafter\CALX_sc_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fncsc r}%
\def\calxFpSinc #1{\romannumeral0\expandafter\CALX_sc_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fnsinc r}%
\def\calxFpSind #1{\romannumeral0\expandafter\CALX_dg_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fnsin s}%
\def\calxFpCosd #1{\romannumeral0\expandafter\CALX_dg_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fncos c}%
\def\calxFpTand #1{\romannumeral0\expandafter\CALX_dg_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fntan t}%
\def\calxFpCotd #1{\romannumeral0\expandafter\CALX_dg_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fncot u}%
\def\calxFpSecd #1{\romannumeral0\expandafter\CALX_dg_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fnsec v}%
\def\calxFpCscd #1{\romannumeral0\expandafter\CALX_dg_a
    \romannumeral0\CALX_fround{\XINTdigits}{#1}\CALX_fncsc w}%
\def\calxFpArg {\romannumeral0\CALX_ar_a a0}%
\def\calxFpArgd {\romannumeral0\CALX_ar_a a1}%
\def\calxFppArg {\romannumeral0\CALX_ar_a p0}%
\def\calxFppArgd {\romannumeral0\CALX_ar_a p1}%
\def\calxFpAtantwo #1#2{\romannumeral0\CALX_ar_a a0{#2}{#1}}%
\def\calxFpAtantwod #1#2{\romannumeral0\CALX_ar_a a1{#2}{#1}}%
%    \end{macrocode}
%\begin{lverb}
% Reduction constants (130 digits, mpmath; the 80 digits of xinttrig.sty
% are a prefix): \CALX_trigR = 180/pi, \CALX_trigDg = pi/180;
% \CALX_pdg<P> = pi/180 rounded to P+4 digits, P = 1, ..., 100.
%\end{lverb}
%    \begin{macrocode}
\edef\CALX_trigR{\romannumeral0\CALX_ffromraw
  {57295779513082320876798154814105170332405472466564321549160243861202847148%
  32155263244096899585111094418622338163286489328144826460[-128]}}%
\edef\CALX_trigDg{\romannumeral0\CALX_ffromraw
  {17453292519943295769236907684886127134428718885417254560971914401710091146%
  03449443682241569634509482212304492507379059248385469228[-131]}}%
\def\CALX_pdgmk #1.%
{%
    \expandafter\edef\csname CALX_pdg#1\endcsname
      {\romannumeral0\CALX_fnround{#1+4}{\CALX_trigDg}}%
    \ifnum#1<100 \expandafter\CALX_pdgmk\the\numexpr#1+1\expandafter.\fi
}%
\CALX_pdgmk 1.\let\CALX_pdgmk\undefined
%    \end{macrocode}
% \subsection{Dispatch and kernels for P at most 8}
% Names with uppercase F, I, N are not usable below (catcode 12).
%    \begin{macrocode}
\def\CALX_trigdigits{\XINTdigits}%
\let\CALX_sinaux\XINT_SinAux_b \let\CALX_cosaux\XINT_CosAux_b
%    \end{macrocode}
% ATTENTION setting from here on F, I, N to "other" catcode.
%    \begin{macrocode}
\catcode`F 12 \catcode`I 12 \catcode`N 12
\def\CALX_sin_a #1%
{%
    \if I#1\expandafter\CALX_sin_i\else\expandafter\CALX_sin_g\fi #1
}%
\def\CALX_cos_a #1%
{%
    \if I#1\expandafter\CALX_sin_i\else\expandafter\CALX_cos_g\fi #1
}%
%    \end{macrocode}
% |#1| is I and we perhaps do not want to rely on its catcode being 12.
%    \begin{macrocode}
\def\CALX_sin_i #1#2\xint:{\CALX_tr_sp#2}%
%    \end{macrocode}
%\begin{lverb}
% Dispatch. |X| < 0.8: \CALX_sin_h, \CALX_cos_h below;
% otherwise reduction (\CALX_sin_r, \CALX_cos_r).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_sin_g F#1#2.%
{%
    \ifnum#2=\xint_c_ \xint_dothis\CALX_sin_g_zero\fi
    \xint_orthat\CALX_sin_g_nonzero #1#2.%
}%
\def\CALX_sin_g_zero #1#2.#3.#4\xint:{ F+0.0.}%
\def\CALX_sin_g_nonzero #1#2.#3.#4\xint:%
{%
    \ifnum\numexpr#2+8*#3>\xint_c_ \xint_dothis\CALX_sin_r\fi
    \ifnum\ifnum\numexpr#2+8*#3=\xint_c_
      \CALX_trig_top#4\xint:\else0\fi>\xint_c_vii
      \xint_dothis\CALX_sin_r\fi
    \xint_orthat\CALX_sin_g_small #1#2.#3.#4\xint:%
}%
\def\CALX_sin_g_small #1#2.#3.#4\xint:%
{\expandafter\CALX_sin_h\the\numexpr(\CALX_trigdigits+7)/8%
                 .#1#2.#3.#4\xint:}%
\def\CALX_cos_g F#1#2.%
{%
    \ifnum#2=\xint_c_ \xint_dothis\CALX_cos_g_zero\fi
    \xint_orthat\CALX_cos_g_nonzero #1#2.%
}%
\def\CALX_cos_g_zero #1#2.#3.#4\xint:{ F+1.0.100000001!}%
\def\CALX_cos_g_nonzero #1#2.#3.#4\xint:%
{%
    \ifnum\numexpr#2+8*#3>\xint_c_ \xint_dothis\CALX_cos_g_reduce\fi
    \ifnum\ifnum\numexpr#2+8*#3=\xint_c_
      \CALX_trig_top#4\xint:\else0\fi>\xint_c_vii
      \xint_dothis\CALX_cos_g_reduce\fi
    \xint_orthat\CALX_cos_g_small #1#2.#3.#4\xint:%
}%
\def\CALX_cos_g_reduce #1#2.#3.#4\xint:{\CALX_cos_r+#2.#3.#4\xint:}%
\def\CALX_cos_g_small #1#2.#3.#4\xint:%
{\expandafter\CALX_cos_h\the\numexpr(\CALX_trigdigits+7)/8%
                 .#1#2.#3.#4\xint:}%
\def\CALX_trig_top 1#1#2!#3\xint:%
{%
    \if\relax\detokenize{#3}\relax\expandafter\xint_firstoftwo
    \else\expandafter\xint_secondoftwo\fi
    {#1}{\CALX_trig_top#3\xint:}%
}%
%    \end{macrocode}
%\begin{lverb}
% P <= 8, |X| < 0.8 (\CALX_sin_q, \CALX_cos_q, called by \CALX_sin_h,
% \CALX_cos_h): X has E = D + 8e <= 0 (|X| < 10^E); X may have up to
% 8m digits (reduced argument). E < -4: sin X = round_P(X), cos X = 1
% (u/6 < 2 10^-11). Else A = the top 9 digits of M rounded (\CALX_rta),
% X = A 10^(E-9) (1 + d), |d| < 6 10^-9; U9 = round(round(A^2/10^9) /
% 10^(-2E)) (= round(10^9 u) within 1); S9 = 10^9 sin(X)/X, C9 = 10^9
% cos(X) by the Horner kernels of xinttrig; sin X = round_P(round(A
% S9/10^9) 10^(E-9)), cos X = round_P(C9 10^-9), both rounded and
% written as natives by \CALX_dgo (below).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_sin_q #1#2.#3.%
{%
    \ifnum\numexpr#2+8*#3<-\xint_c_iv
      \xint_dothis\CALX_sin_q_tiny\fi
    \xint_orthat\CALX_sin_q_compute #1#2.#3.%
}%
\def\CALX_sin_q_tiny #1#2.#3.#4\xint:%
  {\CALX_fnround{\CALX_trigdigits}{F#1#2.#3.#4}}%
\def\CALX_sin_q_compute #1#2.#3.#4\xint:%
{%
    \expandafter\CALX_sqa\the\numexpr#2+8*#3\expandafter.%
      \the\numexpr(2*#2+7)/16\expandafter.%
      \the\numexpr#2+8-8*((2*#2+7)/16).#1#4\xint:%
}%
\def\CALX_sqa #1.#2.#3.#4#5\xint:%
  {\expandafter\CALX_sqb\the\numexpr\CALX_rta#2.#3.#5\xint:.#4#1.}%
\def\CALX_sqb #1.#2#3.%
{%
    \expandafter\CALX_dgo\the\numexpr#2#1*(%
      \expandafter\CALX_sinaux\the\numexpr#1*#1/1000000000/%
      \CALX_pten{-2*#3}.)/1000000000.#3-9.%
}%
\def\CALX_cos_q #1#2.#3.%
{%
    \ifnum\numexpr#2+8*#3<-\xint_c_iv \xint_dothis\CALX_cos_q_tiny\fi
    \xint_orthat\CALX_cos_q_compute #1#2.#3.%
}%
\def\CALX_cos_q_tiny #1#2.#3.#4\xint:{ F+1.0.100000001!}%
\def\CALX_cos_q_compute #1#2.#3.#4\xint:%
{%
    \expandafter\CALX_cqa\the\numexpr#2+8*#3\expandafter.%
      \the\numexpr(2*#2+7)/16\expandafter.%
      \the\numexpr#2+8-8*((2*#2+7)/16).#4\xint:%
}%
\def\CALX_cqa #1.#2.#3.#4\xint:%
  {\expandafter\CALX_cqb\the\numexpr\CALX_rta#2.#3.#4\xint:.#1.}%
\def\CALX_cqb #1.#2.%
{%
    \expandafter\CALX_dgo\the\numexpr
      \expandafter\CALX_cosaux\the\numexpr#1*#1/1000000000/%
      \CALX_pten{-2*#2}..-9.%
}%
%    \end{macrocode}
%\begin{lverb}
% sind, cosd, tand, cotd, secd, cscd for P <= 8, all in \numexpr,
% 9-digit fixed point as \CALX_sin_q (kinds s, c, t, u, v, w). P > 8, NaN and
% infinities go to \CALX_sc_a (jumper \CALX_dg_j), zero gives 0 or 1.
%
% Input (after \CALX_fround to P): |x| = A 10^(E-9) EXACTLY, E = D + 8e,
% A integer, 10^8 <= A < 10^9 (\CALX_dg_one$empty: one block, A = b 10^(9-D);
