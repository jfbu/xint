%\begin{lverb}
% \calxFpOpp: sign flip, the tag token kept; F+0.0., M+0.0. and I?
% unchanged. F, M and I: \CALX_fopp_a.
%\end{lverb}
%    \begin{macrocode}
\def\calxFpOpp #1%
   {\romannumeral0\expandafter\CALX_fopp_e\romannumeral`&&@#1\xint:}%
%    \end{macrocode}
%\begin{lverb}
% raw input (strict A[N], A/B[N]): \CALX_fopp_x on the first token, a
% leading - removed, a leading 0 (zero) kept, else - prepended.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_fopp_e #1%
   {\if F#1\else\if I#1\else\if M#1\else\CALX_fopp_r\fi\fi\fi
    \CALX_fopp_a #1}%
\def\CALX_fopp_r #1\fi\fi\fi\CALX_fopp_a #2\xint:{\fi\fi\fi\CALX_fopp_x #2\xint:}%
\def\CALX_fopp_x #1#2\xint:%
   {\if-#1\xint_dothis{ #2}\fi\if0#1\xint_dothis{ #1#2}\fi\xint_orthat{ -#1#2}}%
\def\CALX_fopp_a #1#2#3\xint:%
{%
    \if#2-\xint_dothis{ #1+#3}\fi
    \if#2?\xint_dothis{ #1?}\fi
    \if0\CALX_fopp_b#3?\xint:\xint_dothis{ #1+#3}\fi
    \xint_orthat{ #1-#3}%
}%
\def\CALX_fopp_b #1#2\xint:{#1}%
%    \end{macrocode}
%\begin{lverb}
% Syntax (f-expandable; X a value of any parser, f-expanded; k a value
% with \CALX_mr digits, i.e. M or raw integer):
%(
%  \calxiiRound{k}{X}, \calxiiTrunc{k}{X}  -> M (X 10^k rounded, truncated)
%:  \calxiiFloor{X}, \calxiiCeil{X}        -> M
%:  \calxCeilToNum{X}                      -> explicit digits of ceil(X)
%)
% round(x, k), trunc(x, k), floor(), ceil() of \xintiieval, the start
% value of n++. X 10^k as raw A/B[N + k] (M by \CALX_mtoraw_t, F by
