% Fibonacci code
%
% The first version was done on
% December 7, 2013. Expandably computing a big Fibonacci number
% with the help of TeX+\numexpr+\xintexpr, © Jean-François B.
%
% The code was redone on September 22 (and 27) 2025, after the
% 1.4o release, so for 1.4p release.
% Less multiplications.
% First convert to binary with the help of \xintDecToBin.
% This second version though requires positive argument.
%
% Transferred from bnumexpr.dtx with \xintiiexpr replacing \bnumexpr,
% comments in sync on Sep. 27.
% (MEMO: we are already here in the document body but a catcode active
% semi-colon from babel-french for example is not here a problem).
\makeatletter
\newcommand\Fibonacci[1]{%
    \expandafter\Fibo@start
    \romannumeral0\xintdectobin{\the\numexpr#1\relax};%
}
% To chain \xintiiexpr's easily we use the once-expanded form which is
% \romannumeral0\xintiiexpro.  We could also have used \expanded and \xintiieval
% calls, that would have been simpler but old habits die hard.
%
% Gobble the first digit which is 1 (this is where we could have tested for a
% negative or zero input).  Prepare encapsulated 1 and 0.  Then repeatedly
% dispatch according to binary digits (which are strategically located at end
% of input stream to optimize), or the semicolon which signals completion.
%
% We use \csname-governed branching (because it is cool).  We could have
% used some \if test or even an \ifcase with an {-1} at end, or any other
% of the many possibilities opened up by TeX syntax.
\def\Fibo@start 1#1{%
    \csname Fibo@#1\expandafter\endcsname
        \romannumeral0\xintiiexpro 1\expandafter\relax\expandafter;%
        \romannumeral0\xintiiexpro 0\relax;%
}
\@namedef{Fibo@0}#1;#2;#3{%
    \csname Fibo@#3\expandafter\endcsname
       \romannumeral0\xintiiexpro (#1+2*#2)*#1\expandafter\relax\expandafter;%
       \romannumeral0\xintiiexpro #1*#1+#2*#2\relax;%
}
\@namedef{Fibo@1}#1;#2;#3{%
    \csname Fibo@#3\expandafter\endcsname
        \romannumeral0\xintiiexpro 2*(#1+#2)*#1+#2*#2\expandafter\relax\expandafter;%
        \romannumeral0\xintiiexpro (#1+2*#2)*#1\relax;%
}
% #1 is F_N (and #2 is F_{N-1}) but in need of unpacking.
\@namedef{Fibo@;}#1;#2;{\xintthe#1}
\makeatother

\def\specialprintone #1%
{%
    \ifx #1\relax \else \makebox[877496sp]{#1}\hskip 0pt plus 2sp\relax
    \expandafter\specialprintone\fi
}%
\def\specialprintnumber #1% first ``fully'' expands its argument.
{\expandafter\specialprintone \romannumeral-`0#1\relax }%

% Updated september 9, 2025, 11 years and 8 months after initial
% version, to add a nice legend at bottom right and print F_{1250}
% at top left.  I don't think many people had understood that the
% displayed digits were those of the 1250th Fibonacci number...
%
\AddToShipoutPicture*{%
    \put(10.5cm,14.85cm)
    {\edef\z{\Fibonacci{1250}}%
     \makebox(0,0)
      {\resizebox{17cm}{!}{%
        \vbox{\hsize 8cm\Huge
         \baselineskip.8\baselineskip
         \color{black!15}%
         \makebox[6\dimexpr877496sp\relax][l]{$F_{1250}={}$}%
         \hskip0pt plus12sp\relax
         \specialprintnumber{\z}% <-- careful no space token here
         \parbox[c]{5.5\fontcharwd\font`0 }% 5 cm is a bit too narrow for text
                   {\color{black}\tiny
                    \raggedright The $1250^{th}$ Fibonacci number has
                    \expandafter\xintLength\expandafter{\z} digits.\par}%
          \kern-0.5\fontcharwd\font`0
         \par
        }%
                          }% arg of \resizebox
     }%
    }%
}


