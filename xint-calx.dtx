%
% calx: the onliterals are looked up per parser
% (\XINT_<p>_onliteral_<name>): the \xinteval ones are copied
% for \xintfloateval and \xintiieval. qint() of \xintiieval
% gives an M value, qfloat() of \xintfloateval an F value (as float()),
% random() and qrand() of \xintfloateval F values (calxfp's
% \calxFpRandomSdigits, \calxFpRandomSixteen).
% The argument of qfloat() of \xintfloateval is read by \CALX_fround: a
% raw value A, A[N], A/B, A/B[N] (any xintfrac input with xintexpr.sty).
% qfrac(A/B) (the slash is mandatory; A and B f-expand to integers in
% strict format: 0 or an optional - then digits without leading zero):
% \xintfloateval: A/B rounded to P digits (\CALX_fqfrac: exact F values
% of A and B by calxfp's \CALX_ffromraw, then its correctly rounded
% division \CALX_fr_xk; B may be negative; B = 0 signals as x / 0);
% \xintiieval: A/B[0] (B > 0), for round(), trunc(), num() etc. The
% \xinteval qfrac() (\xintRaw, any xintfrac input) is xintexpr.sty's;
% loading it does not change the two calx ones.
%\end{lverb}
