%    \begin{macrocode}
\begingroup\catcode61\catcode48\catcode32=10\relax%
  \catcode13=5    % ^^M
  \endlinechar=13 %
  \catcode123=1   % {
  \catcode125=2   % }
  \catcode64=11   % @
  \catcode44=12   % ,
  \catcode46=12   % .
  \catcode58=12   % :
  \catcode94=7    % ^
  \catcode35=6    % #
  \catcode33=12   % !
  \def\empty{}\def\space{ }\newlinechar10
  \expandafter\let\expandafter\t\csname ver@calxtrig.tex\endcsname
  \expandafter\let\expandafter\c\csname ver@calx.sty\endcsname
  \expandafter
    \ifx\csname PackageWarningNoLine\endcsname\relax
      \def\y#1#2{\immediate\write128{^^JPackage #1 Warning:^^J%
                 \space\space\space\space#2.^^J}}%
    \else
      \def\y#1#2{\PackageWarningNoLine{#1}{#2}}%
    \fi
  % attention that in this file \z by default does \endinput.
  \def\z{\endgroup\endinput}%
  \expandafter\ifx\csname numexpr\endcsname\relax
    \y{calx}{\numexpr not available, aborting input}%
  \else
%    \end{macrocode}
% BEWARE: on 2026/10/09 I hit a problem I knew about from years ago but
% forgot.  It is known that TeX executes all macros on the line where
% |\endinput| is found.  But imagine |\endinput\input foo.tex\relax|, 
% then what will happen is that only the first line of foo.tex
% (if its EOL is not hidden by a comment char) is executed, so basically
% foo.tex is not read beyond that. I will put |\endinput| last in both
% situations, as is logical anyhow.
%    \begin{macrocode}
      \ifx\c\relax % calx.sty not yet loaded.
        \ifx\PackageWarningNoLine\relax
          \y{calx}{%
             Loading of calxtrig.tex should happen via
             \string\input\space calx.sty\relax^^J\space\space\space\space
             Will try that now%
          }%
          \def\z{\endgroup
                 \input calx.sty\relax\endinput}%
        \else
          \y{calx}{%
             Bad move! Inputting calxtrig.tex directly in a LaTeX\MessageBreak
             document is forbidden! Simply use \string\usepackage{calx}\MessageBreak
             in the preamble, as every obedient LaTeX user does!\MessageBreak
             Trying to recover now, hoping to be in the preamble%
          }%
          \def\z{\endgroup
                 \RequirePackage{calx}\endinput}%
        \fi
      \else % either calx.sty is trying to load us, or a second loading is
            % attempted on us by \input. Abort if the latter.
        \ifx\t\relax
            \def\z{\endgroup}%
        \else
            \y{calx}{calxtrig.tex already loaded! Aborting this input}%
        \fi
      \fi
  \fi
\z%
%    \end{macrocode}
