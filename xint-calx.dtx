% (\CALX_seq_m); \xintfloatSeq:tl:x (\xintfloateval): F items (\CALX_seq_f).
% b = I-: the single item ceil(a). b = I+ or I?, or a an I value: an
% expandable error, empty list.
%
% ceil and floor by calxfp's \CALX_fint (sign s, |trunc| T, first omitted
% digit d, non-zero flag z) and its kind macros \CALX_fintk_c,
% \CALX_fintk_f: \CALX_seq_k writes sTs<k>sdz, i.e. s(T + a), in \numexpr.
% The loop carries the item builder after the two ends.
%\end{lverb}
%    \begin{macrocode}
