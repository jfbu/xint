% \subsubsection{\csh{CALX_nsqrt_core}}
%\begin{lverb}
% \CALX_nsqrt_core <cont>{n}{blocks}: n even >= 4, top block >= 25000000
% (block of 8 digits). Gives <cont>{s}{r} (natives), s = isqrt, r = X - s^2.
%
% n = 4, 6: \CALX_nsqrt_iv, \CALX_nsqrt_vi; n >= 8: \CALX_nsqrt_k (one
% block steps). With <cont> = \CALX_nsqrt_un (padded input, see
% \CALX_nsqrtrem) and n = 6 or n >= 8, the root is not built as a native:
% \CALX_nsqrt_cvu passes the output of \CALX_nsqrt_vi to \CALX_nsqrt_kb,
% and the final state goes to \CALX_nsqrt_kuz (S and R of the unpadded
% input directly).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_core #1#2%
{%
    \ifcase\numexpr#2/\xint_c_ii-\xint_c_ii\relax
         \xint_dothis\CALX_nsqrt_civ
    \or  \xint_dothis{\ifx\CALX_nsqrt_un#1\expandafter\CALX_nsqrt_cvu
                      \else\expandafter\CALX_nsqrt_cvi\fi}%
    \fi\xint_orthat\CALX_nsqrt_k #1{#2}%
}%
\def\CALX_nsqrt_cvu #1#2#3{\CALX_nsqrt_msvi#3\CALX_nsqrt_vi\CALX_nsqrt_kb%
    \xint:{}#1}%
\def\CALX_nsqrt_civ #1#2#3{\CALX_nsqrt_msiv#3\CALX_nsqrt_iv\CALX_nsqrt_ivo#1}%
\def\CALX_nsqrt_msiv 1#1!1#2!1#3!1#4!#5#6{#5#6{#4}{#3}{#2}{#1}}%
\def\CALX_nsqrt_ivo #1#2#3#4%
   {\expandafter\CALX_nsqrt_ivp\romannumeral0\CALX_nsqrt_nathl{#3}{#4}%
       \xint:{N+2.#2!1#1!}}%
\def\CALX_nsqrt_ivp #1\xint:#2#3{#3{#2}{#1}}%
\def\CALX_nsqrt_cvi #1#2#3{\CALX_nsqrt_msvi#3\CALX_nsqrt_vi\CALX_nsqrt_vio#1}%
\def\CALX_nsqrt_msvi %
    1#1!1#2!1#3!1#4!1#5!1#6!#7#8{#7#8{#6}{#5}{#4}{#3}{#2}{#1}}%
\def\CALX_nsqrt_vio #1#2#3#4#5#6%
   {\expandafter\CALX_nsqrt_ivp\romannumeral0\CALX_nsqrt_natr{#4}{#5}{#6}%
       \xint:{N+3.#3!#2!1#1!}}%
%    \end{macrocode}
% \subsubsection{\csh{CALX_nsqrt_k}}
%\begin{lverb}
% \CALX_nsqrt_k <cont>{n}{blocks}: n even >= 8, top block >= 25000000.
% Same output as \CALX_nsqrt_core. The root of the top six blocks is
% obtained by \CALX_nsqrt_vi, then the root is extended by one block for
% each further pair of blocks (one Zimmermann step with b = B each time).
%
% Step. Let s (k blocks, k >= 3) be the root of the top 2k blocks,
% r = (top 2k blocks) - s^2 (0 <= r <= 2s), t = 2s, and a1, a0 the next two
% blocks. With W = r B + a1, the next block of the root is the largest q
% such that W B + a0 - q (t B + q) >= 0; it is q = floor(W/t) or that
% value minus one. Then s <- s B + q, t <- t B + 2q, r <- that difference.
% As s >= B^k/2 (normalized input), B^k <= t < 2 B^k: the top block t_k
% of t is 1.
%
% State. P = 1t_0!1r_0!1t_1!1r_1!...1t_k!1r_k!1;;;;;! (the blocks of t and
% r interleaved, least significant first, r padded with zero blocks). Then
% L = 1<a1>!P is exactly the layout of the window W and the divisor t used
% by the multiply-subtract pass of the division (\CALX_ndms_a): the pairs
% (w_j, t_j) with w_0 = a1, w_j = r_(j-1), then w_(k+1) = r_k and the
% marker.
%
% \CALX_nsqrt_k reverses the blocks (most significant first), gives the top
% six to \CALX_nsqrt_vi with continuation \CALX_nsqrt_kb, which builds P
% (k = 3) from its output. \CALX_nsqrt_ks {k}{P} <pairs>\xint: loops while
% pairs of blocks remain, then goes to \CALX_nsqrt_kz. \CALX_nsqrt_kt
% copies L and skips 2k-4 blocks (\CALX_nskip) to read the top blocks of r
% and t for the estimate (\CALX_nsqrt_ku).
%
% \CALX_nsqrt_kfl{x}: floor(x/B) for 0 <= x < 2B, in \numexpr.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_k #1#2#3%
   {\expandafter\CALX_nsqrt_ka\romannumeral0\CALX_rev_nounsep{}#3\R!\R!\R!\R!%
       \R!\R!\R!\R!\W
    \xint:{}#1}%
\def\CALX_nsqrt_ka 1#1!1#2!1#3!1#4!1#5!1#6!#7\xint:%
   {\CALX_nsqrt_vi\CALX_nsqrt_kb{#1}{#2}{#3}{#4}{#5}{#6}#7\xint:}%
\def\CALX_nsqrt_kfl #1{((#1+50000000)/\xint_c_e_viii-\xint_c_i)}%
\def\CALX_nsqrt_kb #1#2#3#4#5#6%
{%
    \expandafter\CALX_nsqrt_ks\expanded{{3}{%
    \the\numexpr\xint_c_ii*#3-\xint_c_e_viii
       -\CALX_nsqrt_kfl{\xint_c_ii*#3-200000000}*\xint_c_e_viii!%
    \the\numexpr\xint_c_e_viii+#6!%
    \the\numexpr\xint_c_ii*#2-\xint_c_e_viii+\CALX_nsqrt_kfl{%
        \xint_c_ii*#3-200000000}%
       -\CALX_nsqrt_kfl{\xint_c_ii*#2-200000000
            +\CALX_nsqrt_kfl{\xint_c_ii*#3-200000000}}*\xint_c_e_viii!%
    \the\numexpr\xint_c_e_viii+#5!%
    \the\numexpr\xint_c_ii*#1+\CALX_nsqrt_kfl{\xint_c_ii*#2-200000000
            +\CALX_nsqrt_kfl{\xint_c_ii*#3-200000000}}!%
    \the\numexpr#4-\CALX_nsqrt_kfl{#4}*\xint_c_e_viii+\xint_c_e_viii!%
    100000001!%
    \the\numexpr\CALX_nsqrt_kfl{#4}+\xint_c_e_viii!%
    1;;;;;!}}%
}%
\def\CALX_nsqrt_ks #1#2#3%
   {\ifx\xint:#3\expandafter\CALX_nsqrt_kz\else\expandafter\CALX_nsqrt_kt%
       \fi{#1}{#2}#3}%
\def\CALX_nsqrt_kt #1#21#3!1#4!%
   {\CALX_nskip\CALX_nsqrt_ku\xint_c_ii*#1-\xint_c_iv.1#3!#2{#1}{#3}{#4}{#2}}%
\def\CALX_nsqrt_ku 1#1!1#2!1#3!1#4!1#5!1#6!1#7!1;;;;;!#8#9%
{%
    \expandafter\CALX_nsqrt_kec\the\numexpr\xint_c_e_viii+#4\expandafter.%
    \the\numexpr#2\expandafter.\expandafter{\the\numexpr#7*\xint_c_e_viii+#5}%
    {#3}{{#8}{#9}}{#1}{}%
}%
%    \end{macrocode}
% \subsubsection{\csh{CALX_nsqrt_kec}}
%\begin{lverb}
% Estimate. With U = (r_k B + r_(k-1)) B^2 + r_(k-2) B + r_(k-3) (three
% limbs, the top one below 2 10^8) and V = (B + t_(k-1)) B + t_(k-2), the
% value q* = floor(U/V) satisfies q <= q* <= q + 1 where q = floor(W/t),
% and q* = q + 1 only if the lower blocks matter (probability about
% 10^-8): W/t < (U + 1)/V and W/t >= U/(V + 1), and U/V - U/(V + 1) < 1.
% The computation of q* is that of \CALX_nsqrt_vi (same limbs, same bounds:
% tH = B + t_(k-1) is in [10^8, 2 10^8)): \CALX_nsqrt_kec ... _keksub are
% copies of \CALX_nsqrt_vi_c ... _vi_ksub, renamed, which end with
% \CALX_nsqrt_kq instead of \CALX_nsqrt_vi_r.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_kec #1.#2.#3#4#5#6#7%
   {\expandafter\CALX_nsqrt_ked\the\numexpr#3*%
       \xint_c_e_viii/#1.#1.#2.{#3}{#4}{#6}{#7}{#5}}%
\def\CALX_nsqrt_ked #1.#2.#3.%
{%
    \expandafter\CALX_nsqrt_kee
    \the\numexpr(#1+5000)/\xint_c_e_iv-\xint_c_i\expandafter.%
    \the\numexpr(#2+5000)/\xint_c_e_iv-\xint_c_i\expandafter.%
    \the\numexpr(#3+5000)/\xint_c_e_iv-\xint_c_i.#1.#2.#3.%
}%
\def\CALX_nsqrt_kee #1.#2.#3.#4.#5.#6.#7#8#9%
{%
    \expandafter\CALX_nsqrt_kef
    \the\numexpr#9-(#4-#1*\xint_c_e_iv)*(#6-#3*\xint_c_e_iv)\expandafter.%
    \the\numexpr-#1*(#6-#3*\xint_c_e_iv)-(#4-#1*\xint_c_e_iv)*#3\expandafter.%
    \the\numexpr((#7-#1*#2)*\xint_c_e_iv
       -(#1*(#5-#2*\xint_c_e_iv)+(#4-#1*\xint_c_e_iv)*#2))*\xint_c_e_iv
       +#8-(#1*#3+(#4-#1*\xint_c_e_iv)*(#5-#2*\xint_c_e_iv)).#4.#5.#6.%
}%
\def\CALX_nsqrt_kef #1.#2.%
{%
    \expandafter\CALX_nsqrt_keg
    \the\numexpr#2+(#1+500005000)/\xint_c_e_iv-50001\expandafter.%
    \the\numexpr#1-((#1+500005000)/\xint_c_e_iv-50001)*\xint_c_e_iv.%
}%
\def\CALX_nsqrt_keg #1.#2.#3.%
{%
    \expandafter\CALX_nsqrt_kek
    \the\numexpr#3+(#1+500005000)/\xint_c_e_iv-50001\expandafter.%
    \the\numexpr(#1-((#1+500005000)/\xint_c_e_iv-50001)*\xint_c_e_iv)*%
        \xint_c_e_iv+#2.%
}%
\def\CALX_nsqrt_kek #1.%
{%
    \ifnum#1<\xint_c_ \expandafter\CALX_nsqrt_kekadd
    \else\expandafter\CALX_nsqrt_kekcmp\fi #1.%
}%
\def\CALX_nsqrt_kekadd #1.#2.#3.#4.#5.%
{%
    \expandafter\CALX_nsqrt_kek
    \the\numexpr#1+#4+(#2+#5+50000000)/\xint_c_e_viii-\xint_c_i\expandafter.%
    \the\numexpr#2+#5-((#2+#5+50000000)/\xint_c_e_viii-\xint_c_i)*%
        \xint_c_e_viii
    \expandafter.\the\numexpr#3-\xint_c_i.#4.#5.%
}%
\def\CALX_nsqrt_kekcmp #1.#2.#3.#4.#5.%
{%
    \ifcase\numexpr\ifnum#1<#4 0\else\ifnum#1>#4 1\else
                   \ifnum#2<#5 0\else 1\fi\fi\fi\relax
         \expandafter\CALX_nsqrt_kq
    \or  \expandafter\CALX_nsqrt_keksub
    \fi #1.#2.#3.#4.#5.%
