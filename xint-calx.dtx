\def\XINT_factortens_y{.\XINT_factortens_y}%
\def\XINT_factortens_cc #1#2#3#4#5#6#7#8#9%
   {\expandafter\XINT_factortens_d\the\numexpr #8#7#6#5#4#3#2#1\relax
