%)
% xintexpr.sty redefines xintfrac's \xintPow: ^, ** and pow() of
% \xinteval use it. b = 0: 1[0]. b an integer: exact power
% (xintfrac) if numerator and denominator of the result have at most
% about 10000 digits, else xintfrac's float power at \XINTdigits. b not
% an integer (half-integers included): \calxFpPow, the power of
% \xintfloateval, its result converted to raw. a = 0, b < 0:
% InvalidOperation, value 0 (as 1/0 in \xinteval).
%\end{lverb}
%    \begin{macrocode}
\def\xintPow{\romannumeral0\xintpow}%
\def\xintpow#1#2%
{%
    \expandafter\XINT_scipow_a\romannumeral0\xintrez{#2}\XINT_pow_int{#1}%
