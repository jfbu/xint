\def\CALX_fr_b #1.%
   {\csname CALX_fr_k\ifnum#1>\xint_c_ \ifnum#1>47 gen\else#1\fi\else0\fi
    \endcsname #1.}%
\def\CALX_fblocks #1#2{\expandafter\CALX_fb_a\the\numexpr#1\expandafter.%
    \romannumeral`&&@#2}%
\def\CALX_fb_a #1.#2{\if I#2\xint_dothis{ I}\fi\xint_orthat{\CALX_fb_c #1.}}%
\def\CALX_fb_c #1.#2#3.%
   {\expandafter\CALX_fr_b\the\numexpr\xint_c_viii*((#3+\xint_c_iii)/%
       \xint_c_viii-#1).#2#3.}%
\def\CALX_fr_id #1.#2#3.{ F#2#3.}%
\def\CALX_fr_gz #1{#1}%
\def\CALX_fr_gi #1#2#3#41#5!{#1{#2}{#3}{#4}}%
\def\CALX_fr_gii #1#2#3#41#5!1#6!{#1{#2}{#3}{#4}}%
