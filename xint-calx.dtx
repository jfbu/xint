% \subsection{Addition and subtraction}
% \subsubsection{\csh{CALX_fadd}, \csh{CALX_fsub}}
%\begin{lverb}
% Syntax (use with \romannumeral0; P a \numexpr expression; X, Y
% f-expanded F, I or raw values, rounded to P digits first):
%(
%  \CALX_fadd{P}{X}{Y}   -> <space>Z    Z = round_P(X + Y)
%:  \CALX_fsub{P}{X}{Y}   -> <space>Z    Z = round_P(X - Y)
%:  \CALX_faddu{P}{X}{Y}  -> <space>Z    (X, Y finite F, at most P digits)
%:  \CALX_fsubu{P}{X}{Y}  -> <space>Z
%)
% Z: F or I value.
%(
%  \CALX_fhalf{X}  -> F...   X/2 exact (X finite F; f-expandable)
%)
%
% \CALX_fadd{P}{X}{Y}, \CALX_fsub{P}{X}{Y} (use with \romannumeral0, X and
% Y f-expanded): round_P(round_P(X) + round_P(Y)), resp. with -round_P(Y),
% round half away from zero, as xint's \XINTinFloatAdd[P] and
% \XINTinFloatSub[P] (xint 1.2k and later).
%
% X is rounded first; \CALX_fa_a grabs it once and checks its tag (X
% special: \CALX_fa_spx rounds Y and goes to \CALX_fa_sp$empty: I?
% propagates, Inf plus finite is that Inf, Inf plus Inf is that Inf if
% the signs agree, else InvalidOperation as in \CALX_nadd). Then Y is
% rounded in front of X, which is written back with the add kernel's
% terminator and one more \xint:
%( <op><Y>\xint:{P}<sX><DX>.<eX>.<X blocks>1;!1;!1;!1;!\W\xint:\xint:
%)
% <op> is \CALX_fa_bp (add) or \CALX_fa_bm (sub: sign of Y flipped, I?
% unchanged); it reads the tag and sign of Y only (Y special: jumper
% \CALX_fa_spy, resp. \CALX_fa_spm, result that special value).
%
% \CALX_fa_c grabs Y's list and X's header; X's list stays in place.
% Jumpers (macros delimited by the \fi of their branch, swallowing the
% rest of the body): Y zero: X (\CALX_fa_rx); X zero: Y (\CALX_fa_ry).
% Cut-off: with t = 8e + D (|X| < 10^t <= 10|X|), if t_X - t_Y >= P + 2
% then |Y| is less than a hundredth of the unit of the last digit of the
% P-digit X and the result is X (also when X is a power of ten and Y has
% the other sign); symmetrically for Y. This is the test of xint's
% \XINT_FL_add_d.
%
% Otherwise the exact sum: one \expanded writes both native headers and
% the e_X - e_Y zero blocks in front of the operand with the larger
% exponent (\CALX_fa_z), and \CALX_nadd_y runs with X's list in place
