       {\romannumeral0\expandafter\CALX_nnorm\expandafter+\expanded{%
           \CALX_nsqrt_kzr#3}1;!}%
       {\romannumeral0\CALX_nmul{\romannumeral0\CALX_nsqrt_natv{#2}}%
          {\romannumeral0\CALX_nsub
