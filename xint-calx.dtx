% sfloat() of \xintfloateval. \calxFpRoundTo, \calxFpTruncTo: exact F
% value (ties away from zero), I unchanged, by \CALX_rt_a; they implement
% round(x, n) and trunc(x, n). The \xint: after Y is removed by \CALX_fbr.
%\end{lverb}
