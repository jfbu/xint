%\begin{lverb}
% Syntax (use with \romannumeral0; k a \numexpr expression, X f-expanded
% native integer or I):
%(
%  \CALX_nshr{k}{X}   -> <space>Y    Y = sign(X) floor(|X|/10^k)
%:  \CALX_nshl{k}{X}   -> <space>Y    Y = X 10^k
%:  \CALX_nshrr{k}{X}  -> <space>Y    Y = sign(X) round(|X|/10^k)
%)
% Decimal shifts of native integers (analogues of \xintDSH, \xintDSx,
% \xintDSRr). Use with \romannumeral0; arguments f-expanded.
%
% \CALX_nshr{k}{X}: sign(X) floor(|X|/10^k) (truncation towards zero).
%
% \CALX_nshl{k}{X}: X 10^k. \CALX_nshrr{k}{X}: |X|/10^k rounded half
% away from zero, sign kept. k >= 0 (k <= 0: X unchanged).
%
% k = 8a + c. Whole blocks: \CALX_nskip (right) or prepended zero blocks
% (left). c > 0: one pass inside \expanded (generated macros
% \CALX_nshr_f<c>, \CALX_nshr_l<c>, \CALX_nshr_e<c>, \CALX_nshl_l<c>,
% \CALX_nshl_e<c>): each new block is a token rearrangement of two
% consecutive blocks, the pending part being the macro argument; no
% arithmetic. End marker 1;;;;;;;;!. The pass ends with \relax<0|1>
% telling whether a top block was dropped (right) or added (left); the
% header N<s><n'>. is built after the pass (one grab of the result).
% I+, I-, I? are returned unchanged (\CALX_nsh_t, one \if test).
%
% \CALX_nshrr$empty: first dropped digit = digit p = (k-1) mod 8 of block
% (k-1) div 8 = (2k-9)/16 (\numexpr, k >= 1), read by \CALX_nskip; +1 by
% \CALX_nadd if >= 5. A result with no block left is N+0.
%\end{lverb}
%    \begin{macrocode}
