%\begin{lverb}
% a..[d]..b of \xintfloateval and \xintiieval: from a by steps d while not
% beyond b; d = 0: a alone; nil if b is on the wrong side of a. Exact
% stepping and comparison: \xintfloatSeqB:tl:x on F values (\CALX_fexact:
% F, M and raw A[N] exactly, A/B[N] with B > 1 rounded to P digits;
% \CALX_faddx, \CALX_fcmp), \calxiiSeqB:tl:x on M values (\CALX_tom,
% \CALX_iiadd, \CALX_iicmp_x). An I value among a, d, b: expandable error,
% empty list. \xinteval has its own (xintexpr.sty).
%
% \CALX_seqb <conv><add><cmp>{a}{d}{b}: the three ends converted by
% <conv> (output Y\xint:), the sign of d by calxcore's \CALX_ifsgn. The loop \CALX_seqb_l
