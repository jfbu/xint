%- \CALX_ndivfloor$empty: sA sB (q + d), d = 1 if sA <> sB and r <> 0, else 0;
%- \CALX_nmod$empty: A - B \CALX_ndivfloor(A,B), i.e. sA r + e sB b with e = 1
% if sA <> sB and r <> 0, else 0 (sign of B or zero);
%- \CALX_nquo$empty: sA sB (q + d), d = 1 if sA = - and r <> 0, else 0; this
% is sB floor(A/b) (xint's \xintiiQuo);
%- \CALX_nrem$empty: A - B \CALX_nquo(A,B) = sA r + e b, e = 1 if sA = - and
% r <> 0, else 0; it is >= 0 (xint's \xintiiRem);
%- \CALX_ndivround$empty: sA sB (q + d), d = 1 if 2r >= b, else 0 (rounding
% half away from zero, xint's \xintiiDivRound);
%- \CALX_ndivision$empty: {\CALX_nquo}{\CALX_nrem} (xint's \xintiiDivision);
%- \CALX_ndivmod$empty: {\CALX_ndivfloor}{\CALX_nmod} (xint's \xintiiDivMod).
%
