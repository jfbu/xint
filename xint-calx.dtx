\def\CALX_nsqrt_kbs #11#2#3!{\xint_gob_til_sc #2\CALX_nsqrt_kbz;%
    \CALX_nsqrt_kbt{#1}{#2#3}}%
%    \end{macrocode}
% Attention to this F. It (probably) should be of catcode 12, so this
