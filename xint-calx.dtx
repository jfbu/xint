% \subsubsection{\csh{xintifNonFiniteSignalled}}
%\begin{lverb}
% True if InvalidOperation, DivisionByZero or Overflow was signalled in
% the current group since the last corresponding flag reset. The flags
% describe conditions, not the result: a handler can return a finite value.
% Literal NaN/Infinity values alone do not raise flags.
%\end{lverb}
%    \begin{macrocode}
\def\xintifNonFiniteSignalled{%
    \calxifflagraised{InvalidOperation}{\xint_firstoftwo}{%
      \calxifflagraised{DivisionByZero}{\xint_firstoftwo}{%
        \calxifflagraised{Overflow}{\xint_firstoftwo}{\xint_secondoftwo}%
      }%
    }%
