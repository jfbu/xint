      \romannumeral0\CALX_fint#1#2\xint:\CALX_fintk_f.#3{#4}}%
}%
\def\CALX_seq_k #1#2.#3#4#5{#1#2#1#5#1#3#4}%
\def\CALX_seq_i #1\xint:#2#3%
   {\if-#1\xint_dothis{\CALX_seq_c.#2{#3}}\fi\xint_orthat\CALX_seq_err}%
\def\CALX_seq_c #1.#2#3%
   {\expandafter\CALX_seq_d\romannumeral`&&@#3\xint:#1.#2}%
