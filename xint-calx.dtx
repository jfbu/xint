% Syntax (use with \romannumeral0; 0 < b <= a < 10^8 as explicit digits,
% a >= b):
%(
%  \CALX_binom_a a.b.  -> <space>N+<n>.<blocks>  binomial(a + b, b)
%)
% The engine of \xintiiBinomial: the accumulator is a block list, most
% significant first; each step multiplies it (\CALX_smallmul, on the list
% reversed by \CALX_rev_nounsep) by a product of consecutive integers and
% divides it (\CALX_smalldivx_a of calxcore) by the matching product of the
% denominator, four, three, two or one factors per step according to the
% size of the factors (< 10^8); very small arguments: one \numexpr
% a*b/c per step. Native output: the final list is reversed
% (\CALX_rev_nounsep) and given to \CALX_nnorm; very small arguments: one
% block.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_a #1.#2.%
{%
    \expandafter\CALX_binom_b\the\numexpr \xint_c_i+#1.1.#2.100000001!1!;!0!%
}%
%    \end{macrocode}
%\begin{lverb}
% y=x-k+1.j=1.k. On va évaluer par y/1*(y+1)/2*(y+2)/3 etc... On essaie
% de regrouper de manière à utiliser au mieux \numexpr. On peut aller jusqu'à
% x=10000 car 9999*10000<10^8. 463*464*465=99896880, 98*99*100*101=97990200.
% On va vérifier à chaque étape si on dépasse un seuil. Le style de
% l'implémentation diffère de celui que j'avais utilisé pour \xintiiFac. On
% pourrait tout-à-fait avoir une verybigloop, mais bon. Je rajoute aussi un
% verysmall. Le traitement est un peu différent pour elle afin d'aller jusqu'à
% x=29 (et pas seulement 26 si je suivais le modèle des autres, mais je veux
% pouvoir faire binomial(29,1), binomial(29,2), ... en vsmall).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_b #1.%
{%
    \ifnum #1>9999 \xint_dothis\CALX_binom_vbigloop \fi
    \ifnum #1>463  \xint_dothis\CALX_binom_bigloop   \fi
    \ifnum #1>98   \xint_dothis\CALX_binom_medloop   \fi
    \ifnum #1>29   \xint_dothis\CALX_binom_smallloop \fi
                   \xint_orthat\CALX_binom_vsmallloop #1.%
}%
%    \end{macrocode}
%\begin{lverb}
% y.j.k. Au départ on avait x-k+1.1.k. Ensuite on a des blocs 1<8d>!
% donnant le résultat intermédiaire, dans l'ordre, et à la fin on a 1!1;!0!.
% Dans smallloop on peut prendre 4 par 4.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_smallloop #1.#2.#3.%
{%
    \ifcase\numexpr #3-#2\relax
        \expandafter\CALX_binom_end_
    \or \expandafter\CALX_binom_end_i
    \or \expandafter\CALX_binom_end_ii
    \or \expandafter\CALX_binom_end_iii
    \else\expandafter\CALX_binom_smallloop_a
    \fi #1.#2.#3.%
}%
%    \end{macrocode}
%\begin{lverb}
% Ça m'ennuie un peu de reprendre les #1, #2, #3 ici. On a besoin de
% \numexpr pour \CALX_binom_div, mais de \romannumeral0 pour le unsep après
% \CALX_binom_mul.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_smallloop_a #1.#2.#3.%
{%
    \expandafter\CALX_binom_smallloop_b
    \the\numexpr #1+\xint_c_iv\expandafter.%
    \the\numexpr #2+\xint_c_iv\expandafter.%
    \the\numexpr #3\expandafter.%
    \the\numexpr\expandafter\CALX_binom_div
    \the\numexpr #2*(#2+\xint_c_i)*(#2+\xint_c_ii)*(#2+\xint_c_iii)\expandafter
    !\romannumeral0\expandafter\CALX_binom_mul
    \the\numexpr #1*(#1+\xint_c_i)*(#1+\xint_c_ii)*(#1+\xint_c_iii)!%
}%
\def\CALX_binom_smallloop_b #1.%
{%
    \ifnum #1>98  \expandafter\CALX_binom_medloop   \else
                  \expandafter\CALX_binom_smallloop \fi #1.%
}%
%    \end{macrocode}
%\begin{lverb}
% Ici on prend trois par trois.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_medloop #1.#2.#3.%
{%
    \ifcase\numexpr #3-#2\relax
        \expandafter\CALX_binom_end_
    \or \expandafter\CALX_binom_end_i
    \or \expandafter\CALX_binom_end_ii
    \else\expandafter\CALX_binom_medloop_a
    \fi #1.#2.#3.%
}%
\def\CALX_binom_medloop_a #1.#2.#3.%
{%
    \expandafter\CALX_binom_medloop_b
    \the\numexpr #1+\xint_c_iii\expandafter.%
    \the\numexpr #2+\xint_c_iii\expandafter.%
    \the\numexpr #3\expandafter.%
    \the\numexpr\expandafter\CALX_binom_div
        \the\numexpr #2*(#2+\xint_c_i)*(#2+\xint_c_ii)\expandafter
    !\romannumeral0\expandafter\CALX_binom_mul
        \the\numexpr #1*(#1+\xint_c_i)*(#1+\xint_c_ii)!%
}%
\def\CALX_binom_medloop_b #1.%
{%
    \ifnum #1>463 \expandafter\CALX_binom_bigloop   \else
                  \expandafter\CALX_binom_medloop   \fi #1.%
}%
%    \end{macrocode}
%\begin{lverb}
% Ici on prend deux par deux.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_bigloop #1.#2.#3.%
{%
    \ifcase\numexpr #3-#2\relax
        \expandafter\CALX_binom_end_
    \or \expandafter\CALX_binom_end_i
    \else\expandafter\CALX_binom_bigloop_a
    \fi #1.#2.#3.%
}%
\def\CALX_binom_bigloop_a #1.#2.#3.%
{%
    \expandafter\CALX_binom_bigloop_b
    \the\numexpr #1+\xint_c_ii\expandafter.%
    \the\numexpr #2+\xint_c_ii\expandafter.%
    \the\numexpr #3\expandafter.%
    \the\numexpr\expandafter\CALX_binom_div
        \the\numexpr #2*(#2+\xint_c_i)\expandafter
    !\romannumeral0\expandafter\CALX_binom_mul
        \the\numexpr #1*(#1+\xint_c_i)!%
}%
\def\CALX_binom_bigloop_b #1.%
{%
    \ifnum #1>9999 \expandafter\CALX_binom_vbigloop  \else
                   \expandafter\CALX_binom_bigloop   \fi #1.%
}%
%    \end{macrocode}
%\begin{lverb}
% Et finalement un par un.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_vbigloop #1.#2.#3.%
{%
    \ifnum #3=#2
         \expandafter\CALX_binom_end_
    \else\expandafter\CALX_binom_vbigloop_a
    \fi #1.#2.#3.%
}%
\def\CALX_binom_vbigloop_a #1.#2.#3.%
{%
    \expandafter\CALX_binom_vbigloop
    \the\numexpr #1+\xint_c_i\expandafter.%
    \the\numexpr #2+\xint_c_i\expandafter.%
    \the\numexpr #3\expandafter.%
    \the\numexpr\expandafter\CALX_binom_div\the\numexpr #2\expandafter
    !\romannumeral0\CALX_binom_mul #1!%
}%
%    \end{macrocode}
%\begin{lverb}
% y.j.k. La partie very small. y est au plus 26 (non 29 mais retesté
% dans \CALX_binom_vsmallloop_a), et tous les binomial(29,n) sont <10^8. On
% peut donc faire y(y+1)(y+2)(y+3) et aussi il y a le fait que etex fait a*b/c
% en double precision. Pour ne pas bifurquer à la fin sur smallloop, si n=27,
% 27, ou 29 on procède un peu différemment des autres boucles. Si je testais
% aussi #1 après #3-#2 pour les autres il faudrait des terminaisons
% différentes.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_vsmallloop #1.#2.#3.%
{%
    \ifcase\numexpr #3-#2\relax
        \expandafter\CALX_binom_vsmallend_
    \or \expandafter\CALX_binom_vsmallend_i
    \or \expandafter\CALX_binom_vsmallend_ii
    \or \expandafter\CALX_binom_vsmallend_iii
    \else\expandafter\CALX_binom_vsmallloop_a
    \fi #1.#2.#3.%
}%
\def\CALX_binom_vsmallloop_a #1.%
{%
    \ifnum #1>26  \expandafter\CALX_binom_smallloop_a  \else
                  \expandafter\CALX_binom_vsmallloop_b \fi #1.%
}%
\def\CALX_binom_vsmallloop_b #1.#2.#3.%
{%
    \expandafter\CALX_binom_vsmallloop
    \the\numexpr #1+\xint_c_iv\expandafter.%
    \the\numexpr #2+\xint_c_iv\expandafter.%
    \the\numexpr #3\expandafter.%
    \the\numexpr \expandafter\CALX_binom_vsmallmuldiv
    \the\numexpr  #2*(#2+\xint_c_i)*(#2+\xint_c_ii)*(#2+\xint_c_iii)\expandafter
    !\the\numexpr #1*(#1+\xint_c_i)*(#1+\xint_c_ii)*(#1+\xint_c_iii)!%
}%
\def\CALX_binom_mul #1!#21!;!0!%
{%
    \expandafter\CALX_rev_nounsep\expandafter{\expandafter}%
    \the\numexpr\expandafter\CALX_smallmul
    \the\numexpr\xint_c_e_viii+#1\expandafter
    !\romannumeral0\CALX_rev_nounsep {}1;!#2%
    \R!\R!\R!\R!\R!\R!\R!\R!\W
    \R!\R!\R!\R!\R!\R!\R!\R!\W
    1;!%
}%
\def\CALX_binom_div #1!1;!%
{%
    \expandafter\CALX_smalldivx_a
    \the\numexpr #1/\xint_c_ii\expandafter\xint:
    \the\numexpr \xint_c_e_viii+#1!%
}%
%    \end{macrocode}
%\begin{lverb}
% Vaguement envisagé d'éviter le 10^8+ mais bon.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_vsmallmuldiv #1!#2!1#3!{\xint_c_e_viii+#2*#3/#1!}%
%    \end{macrocode}
%\begin{lverb}
% On a des terminaisons communes aux trois situations small, med, big,
% et on est sûr de pouvoir faire les multiplications dans \numexpr, car on
% vient ici *après* avoir comparé à 9999 ou 463 ou 98.
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_end_iii #1.#2.#3.%
{%
    \expandafter\CALX_binom_finish
    \the\numexpr\expandafter\CALX_binom_div
        \the\numexpr #2*(#2+\xint_c_i)*(#2+\xint_c_ii)*(#2+\xint_c_iii)\expandafter
    !\romannumeral0\expandafter\CALX_binom_mul
        \the\numexpr #1*(#1+\xint_c_i)*(#1+\xint_c_ii)*(#1+\xint_c_iii)!%
}%
\def\CALX_binom_end_ii #1.#2.#3.%
{%
    \expandafter\CALX_binom_finish
    \the\numexpr\expandafter\CALX_binom_div
        \the\numexpr #2*(#2+\xint_c_i)*(#2+\xint_c_ii)\expandafter
    !\romannumeral0\expandafter\CALX_binom_mul
        \the\numexpr #1*(#1+\xint_c_i)*(#1+\xint_c_ii)!%
}%
\def\CALX_binom_end_i #1.#2.#3.%
{%
    \expandafter\CALX_binom_finish
    \the\numexpr\expandafter\CALX_binom_div
        \the\numexpr #2*(#2+\xint_c_i)\expandafter
    !\romannumeral0\expandafter\CALX_binom_mul
        \the\numexpr #1*(#1+\xint_c_i)!%
}%
\def\CALX_binom_end_ #1.#2.#3.%
{%
    \expandafter\CALX_binom_finish
    \the\numexpr\expandafter\CALX_binom_div\the\numexpr #2\expandafter
    !\romannumeral0\CALX_binom_mul #1!%
}%
\def\CALX_binom_finish #11!;!0!%
{%
    \expandafter\CALX_nnorm\expandafter+%
    \romannumeral0\CALX_rev_nounsep {}#1\R!\R!\R!\R!\R!\R!\R!\R!\W 1;!%
}%
%    \end{macrocode}
%\begin{lverb}
% Duplication de code seulement pour la boucle avec très
% petits coeffs, mais en plus on fait au maximum des possibilités. (on
% pourrait tester plus le résultat déjà obtenu).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_binom_vsmallend_iii #1.%
{%
    \ifnum #1>26  \expandafter\CALX_binom_end_iii \else
                  \expandafter\CALX_binom_vsmallend_iiib \fi #1.%
}%
\def\CALX_binom_vsmallend_iiib #1.#2.#3.%
{%
    \expandafter\CALX_binom_vsmallfinish
    \the\numexpr \expandafter\CALX_binom_vsmallmuldiv
    \the\numexpr  #2*(#2+\xint_c_i)*(#2+\xint_c_ii)*(#2+\xint_c_iii)\expandafter
    !\the\numexpr #1*(#1+\xint_c_i)*(#1+\xint_c_ii)*(#1+\xint_c_iii)!%
}%
\def\CALX_binom_vsmallend_ii #1.%
{%
    \ifnum #1>27  \expandafter\CALX_binom_end_ii \else
                  \expandafter\CALX_binom_vsmallend_iib \fi #1.%
}%
\def\CALX_binom_vsmallend_iib #1.#2.#3.%
{%
    \expandafter\CALX_binom_vsmallfinish
    \the\numexpr \expandafter\CALX_binom_vsmallmuldiv
    \the\numexpr  #2*(#2+\xint_c_i)*(#2+\xint_c_ii)\expandafter
    !\the\numexpr #1*(#1+\xint_c_i)*(#1+\xint_c_ii)!%
}%
\def\CALX_binom_vsmallend_i #1.%
{%
    \ifnum #1>28  \expandafter\CALX_binom_end_i \else
                  \expandafter\CALX_binom_vsmallend_ib \fi #1.%
}%
\def\CALX_binom_vsmallend_ib #1.#2.#3.%
{%
    \expandafter\CALX_binom_vsmallfinish
    \the\numexpr \expandafter\CALX_binom_vsmallmuldiv
    \the\numexpr  #2*(#2+\xint_c_i)\expandafter
    !\the\numexpr #1*(#1+\xint_c_i)!%
}%
\def\CALX_binom_vsmallend_ #1.%
{%
    \ifnum #1>29  \expandafter\CALX_binom_end_ \else
                  \expandafter\CALX_binom_vsmallend_b \fi #1.%
}%
\def\CALX_binom_vsmallend_b #1.#2.#3.%
{%
    \expandafter\CALX_binom_vsmallfinish
    \the\numexpr\CALX_binom_vsmallmuldiv #2!#1!%
}%
\catcode`N=12
\def\CALX_binom_vsmallfinish#1{%
\def\CALX_binom_vsmallfinish1##1!1!;!0!{#1N+1.1##1!}%
}\CALX_binom_vsmallfinish{ }%
\catcode`N=11
%    \end{macrocode}
