%    \begin{macrocode}
\catcode`F 12
\def\CALX_nsqrt_kbz;\CALX_nsqrt_kbt#1#2{1;;;;;!F}%
\catcode`F 11
\def\CALX_nsqrt_kbt #1#21#3!%
{%
    1#2!\the\numexpr#3+#1+\ifnum\numexpr#3+#1<\xint_c_ 200000000\else%
        \xint_c_e_viii\fi!%
    \ifnum\numexpr#3+#1<\xint_c_ \CALX_nsqrt_kbf\fi
}%
\def\CALX_nsqrt_kbf\fi{\fi\CALX_nsqrt_kbs{-1}}%
\def\CALX_nsqrt_kwh #1#2#3#4#5#6#7#8;;;;;!%
{%
    \expandafter\CALX_nsqrt_ks\expanded{{\the\numexpr#6+\xint_c_i}{%
    \the\numexpr\xint_c_ii*#4-\CALX_nsqrt_kfl{\xint_c_ii*#4}*\xint_c_e_viii+%
        \xint_c_e_viii!%
    \the\numexpr#3+\xint_c_e_viii!%
    \the\numexpr#5+\CALX_nsqrt_kfl{\xint_c_ii*#4}+\xint_c_e_viii!%
    \the\numexpr#2-#1*\xint_c_e_viii+\xint_c_e_viii!%
    #8;;;;;!}}%
}%
%    \end{macrocode}
% \subsubsection{\csh{CALX_nsqrt_kz}}
%\begin{lverb}
% End of the steps. \CALX_nsqrt_kzn$empty: R is the native made of the r
% blocks of P (\CALX_nsqrt_kzr), S = t/2 (t blocks extracted by
% \CALX_nsqrt_kzt, halved by \CALX_nsqrt_kh$empty: block t_i/2, plus 5 10^7
% if t_(i+1) is odd).
%
% \CALX_nsqrt_kuz is used instead when <cont> is \CALX_nsqrt_un, i.e. the
% core worked on Y = X D0^2, D0 = 2^j 10^t' (see \CALX_nsqrt_bgh): it
% receives P, then {D0}{j}{2t'}{5^j}{25^j}. With s, r the root and
% remainder of Y and m = 2^(j+1): one pass over t = 2s, most significant
% block first (\CALX_nsqrt_kva), divides by m (remainder c < m, so
% c B + t_i < 2^31) and shifts right by t' digits (remainder rho), giving
% the blocks of S = floor(s/D0) and, at the end, e = s - S D0 =
% rho 2^j + c/2. Then R = (r + e (t - e))/D0^2 (exact): native operations,
% \CALX_nshr by 2t' digits, then division by 4^j. floor(v/10^t') is
% (2v - 10^t' + 1)/(2 10^t') in \numexpr (no tie, also for t' = 0).
%\end{lverb}
%    \begin{macrocode}
\def\CALX_nsqrt_kz #1#2\xint:#3#4%
{%
    \ifx\CALX_nsqrt_un#4\expandafter\CALX_nsqrt_kuz\else\expandafter%
        \CALX_nsqrt_kzn\fi
    {#2}#4%
}%
\def\CALX_nsqrt_kzn #1%
{%
    \expandafter\CALX_nsqrt_kzz\romannumeral0\expandafter\CALX_nnorm%
        \expandafter+\expanded{\CALX_nsqrt_kzr#1}1;!%
    \xint:{#1}%
}%
\def\CALX_nsqrt_kuz #1#2#3#4#5#6#7%
{%
    \expandafter\CALX_nsqrt_kub\expanded{%
      \expandafter\CALX_nsqrt_kvx\romannumeral0\expandafter\CALX_rev_nounsep%
          \expandafter{\expandafter}%
      \expanded{\CALX_nsqrt_kzt#1}\R!\R!\R!\R!\R!\R!\R!\R!\W 1;!\xint:%
      {\ifcase#4 2\or4\or8\or16\fi}{\ifcase#4 1\or2\or4\or8\fi}{%
          \CALX_pten{#5/\xint_c_ii}}}%
    {#1}{#4}{#5}%
}%
\def\CALX_nsqrt_kvx #1\xint:#2#3#4{\CALX_nsqrt_kva 0.0.{#2}{#3}{#4}#1}%
\def\CALX_nsqrt_kva #1.#2.#3#4#51#6#7!%
{%
    \if;#6\expandafter\CALX_nsqrt_kve\else\expandafter\CALX_nsqrt_kvf\fi
    {#1}{#2}{#3}{#4}{#5}{#6#7}%
}%
\def\CALX_nsqrt_kve #1#2#3#4#5#6{\xint:{\the\numexpr#2*#4+#1/\xint_c_ii}}%
\def\CALX_nsqrt_kvf #1#2#3#4#5#6%
{%
    \expandafter\CALX_nsqrt_kvb
    \the\numexpr(#1*\xint_c_e_viii+#6+#4)/#3-\xint_c_i.#1.#2.#6.{#3}{#4}{#5}%
}%
\def\CALX_nsqrt_kvb #1.#2.#3.#4.#5#6#7%
{%
    \expandafter\CALX_nsqrt_kvc
    \the\numexpr(\xint_c_ii*#1-#7+\xint_c_i)/(\xint_c_ii*#7).#1.%
    \the\numexpr#2*\xint_c_e_viii+#4-#1*#5.#3.{#5}{#6}{#7}%
}%
\def\CALX_nsqrt_kvc #1.#2.#3.#4.#5#6#7%
{%
    \the\numexpr#1+#4*(\xint_c_e_viii/#7)+\xint_c_e_viii!%
    \expandafter\CALX_nsqrt_kva\the\numexpr#3\expandafter.\the%
        \numexpr#2-#1*#7.%
    {#5}{#6}{#7}%
}%
\def\CALX_nsqrt_kub #1\xint:%
{%
    \expandafter\CALX_nsqrt_kuc\romannumeral0\expandafter\CALX_nnorm%
        \expandafter+%
    \romannumeral0\CALX_rev_nounsep{}#1\R!\R!\R!\R!\R!\R!\R!\R!\W 1;!%
    \xint:%
